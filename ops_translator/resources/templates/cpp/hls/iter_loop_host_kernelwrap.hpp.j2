{% if target == "tapa" %}
#else

void tapa_kernelwrapper_outerloop_{{ilh.id}}(
        ops::hls::AccessRange& range, unsigned int outer_iter,
    {% for arg in ilh.joint_args %}
        {% if loop.last %}
            {% if consts %}
                {% set last_check = False %}
            {% else %}
                {% set last_check = True %}
            {% endif %}
        {% else %}
            {% set last_check = False %}
        {% endif %}
        {% if arg is ops_dat %}
        ops::hls::Grid<{{ilh.dats[arg.dat_id][0].typ}}>& arg{{arg.id}}{{"," if not last_check}}
        {% elif arg is ops_gbl %}
        const {{arg.typ}}* {{get_arg_gbl_name(arg)}}{{"," if not last_check}}
        {% endif %}
    {% endfor %}
    {% for const in consts %}
        const {{const.typ}} {{const.ptr}}{{"," if not loop.last}}
    {% endfor %}
){
    {% set read_stencil = ilh.getReadStencil(prog) %}
    {% if read_stencil %}    
    ops::hls::SizeType read_stencil_d_m = { {{read_stencil.d_m[0]}}, {{read_stencil.d_m[1]}}, {{read_stencil.d_m[2]}} };
    ops::hls::SizeType read_stencil_d_p = { {{read_stencil.d_p[0]}}, {{read_stencil.d_p[1]}}, {{read_stencil.d_p[2]}} };
    ops::hls::SizeType write_stencil_d_m = {0,0,0};
    ops::hls::SizeType write_stencil_d_p = {0,0,0};
    {% else %}
    //ERROR: No read_stencil
    {% endif %}
    auto read_stencilConfig = getStencilConfig(arg0.originalProperty, range, vector_factor, mem_vector_factor, read_stencil_d_m, read_stencil_d_p);
    ops::hls::AccessRange read_range;
    getAdjustedRange(arg0.originalProperty, range, read_range, read_stencil_d_m, read_stencil_d_p);
    {% if target == "tapa" %}
    ops::hls::MemConfig memconfig;
    ops::hls::genMemConfig<mem_data_width, axis_data_width, data_width>(arg0.originalProperty.grid_size, read_range, memconfig);
    const unsigned int num_beats = memconfig.total_xblocks * arg0.originalProperty.batch_size;
    const unsigned int num_of_pkts_per_beat = mem_data_width / axis_data_width;
    const unsigned int num_of_pkts = num_beats * num_of_pkts_per_beat;
    {% endif %}
#ifdef DEBUG_LOG
    printAccessRange(range, "common access range");
    printGridProp(arg0.originalProperty, "arg0_originalGridProp");
    printStencilConfig(read_stencilConfig, "read_stencilConfig");
#endif

    unsigned int total_iter_par_factor = {{get_total_PEs(config["SLR_count"],config["iter_par_factor"])}};
    unsigned int adjusted_outer_iter = (outer_iter + total_iter_par_factor - 1) / total_iter_par_factor;

#ifdef DEBUG_LOG
    std::cout << "[DEBUG] Invoking TAPA mega-kernel in simulation mode..." << std::endl;
#endif

#ifdef DEBUG_LOG
    printf("==================================\n");
    printf("Invoke Parameters\n");
    printf("==================================\n");
    printf("num_beats: %d\n", num_beats);
    printf("num_of_pkts: %d\n", num_of_pkts);
    printf("loopback_itr: %d\n", adjusted_outer_iter-1);
    printf("adjusted_outer_iter: %d\n", adjusted_outer_iter);
    {% for idx in range(ndim)%}
    printf("read_stencilConfig.grid_size[{{idx}}]: %d\n", read_stencilConfig.grid_size[{{idx}}]);
    {% endfor %}
    printf("read_stencilConfig.dim: %d\n", read_stencilConfig.dim);
    printf("read_stencilConfig.total_itr: %d\n", read_stencilConfig.total_itr);
    {% for idx in range(ndim)%}
    printf("read_stencilConfig.lower_limit[{{idx}}]: %d\n", read_stencilConfig.lower_limit[{{idx}}]);
    {% endfor %}
    {% for idx in range(ndim)%}
    printf("read_stencilConfig.upper_limit[{{idx}}]: %d\n", read_stencilConfig.upper_limit[{{idx}}]);
    {% endfor %}
    printf("read_stencilConfig.outer_loop_limit: %d\n", read_stencilConfig.outer_loop_limit);
    printf("read_stencilConfig.batch_size: %d\n", read_stencilConfig.batch_size);
    printf("==================================\n");
#endif 

    //Initiating split for tiled altHostBuffers
    {% for arg in ilh.joint_args|ops_dat %}
    {% if arg is ops_read_or_rw %}
    arg{{arg.id}}.set_as_arg();
    {% endif %}
    {% endfor %}

    ::tapa::invoke(sim_mega_kernel_{{ilh.id}}, ops::hls::FPGA::getInstance()->getProgramName().c_str(),
            num_beats, num_of_pkts, adjusted_outer_iter-1, adjusted_outer_iter,
        {% for idx in range(ndim)%}
            read_stencilConfig.grid_size[{{idx}}],
        {% endfor %}
            read_stencilConfig.dim,
            read_stencilConfig.total_itr,
        {% for idx in range(ndim)%}
            read_stencilConfig.lower_limit[{{idx}}],
        {% endfor %}
        {% for idx in range(ndim)%}
            read_stencilConfig.upper_limit[{{idx}}],
        {% endfor %}
            read_stencilConfig.outer_loop_limit,
            read_stencilConfig.batch_size,
        {% for arg in ilh.joint_args|ops_gbl%}
            *{{get_arg_gbl_name(arg)}},
        {% endfor %}
        {% for const in consts %}
            {{const.ptr}},
        {% endfor %}
        {% for arg in ilh.joint_args|ops_dat %}
#ifdef OPS_TILING
            {% if config["tile_banks"] > 1 and config["datamover_lib"] == 1 %}
                {% for i in range(config["tile_banks"]) %}
            ::tapa::read_write_mmap<::tapa::vec_t<stencil_type, mem_vector_factor>>(
                reinterpret_cast<::tapa::vec_t<stencil_type, mem_vector_factor>*>(arg{{arg.id}}.altHostBuffers[{{i}}].data()),
                arg{{arg.id}}.altHostBuffers[{{i}}].size() / mem_vector_factor){{", " if not loop.last}}
                {% endfor %}
            {% else %}
            ::tapa::read_write_mmap<::tapa::vec_t<stencil_type, mem_vector_factor>>(
                    reinterpret_cast<::tapa::vec_t<stencil_type, mem_vector_factor>*>(arg{{arg.id}}.altHostBuffers[0].data()),
                    arg{{arg.id}}.altHostBuffers[0].size() / mem_vector_factor){{", " if not loop.last}}
            {% endif %}
#else
            ::tapa::read_write_mmap<::tapa::vec_t<stencil_type, mem_vector_factor>>(
                    reinterpret_cast<::tapa::vec_t<stencil_type, mem_vector_factor>*>(arg{{arg.id}}.hostBuffer.data()),
                    arg{{arg.id}}.hostBuffer.size() / mem_vector_factor){{", " if not loop.last}}
#endif
        {% endfor %}
    );
}
#endif
{% endif %}
{% endblock %}

{% block par_loop %}
