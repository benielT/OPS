            const {{arg.typ}}* {{get_arg_gbl_name(arg)}}{{"," if not last_check}}
        {% endif %}
    {% endfor %}
    {# {% for const in consts %}
            const {{const.typ}} {{const.ptr}}{{"," if not loop.last}}
    {% endfor %} #}
)
{
    ops::hls::AccessRange range;
