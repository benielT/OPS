    {% if target == "tapa" %}
#if !defined(TAPA_SW_EMU) && !defined(TAPA_HW_EMU)
    {% endif %}
    static  KernelWrapper_outerloop_{{ilh.id}} kernelWrapper_inst;
    {% for arg in ilh.joint_args|ops_dat %}
        {% if arg is ops_read %}
    sendGrid(arg{{ilh.getArg(arg.dat_id).id}});
        {% endif %}
    {% endfor %}
    
    kernelWrapper_inst.run(range, outer_iter,
    {% for arg in ilh.joint_args %}
        {% if loop.last %}
            {% if consts %}
                {% set last_check = False %}
            {% else %}
                {% set last_check = True %}
            {% endif %}
        {% else %}
            {% set last_check = False %}
        {% endif %}
        {% if arg is ops_dat %}
            arg{{arg.id}}{{"," if not last_check}}
        {% elif arg is ops_gbl %}
            {{get_arg_gbl_name(arg)}}{{"," if not last_check}}
        {% endif %}
    {% endfor %}
    {% for const in consts %}
            {{const.ptr}}{{"," if not loop.last}}
    {% endfor %}
    );
    {% if target == "tapa" %}
#else
    tapa_kernelwrapper_outerloop_{{ilh.id}}(range, outer_iter,
        {% for arg in ilh.joint_args %}
            {% if loop.last %}
                {% if consts %}
                    {% set last_check = False %}
                {% else %}
                    {% set last_check = True %}
                {% endif %}
            {% else %}
                {% set last_check = False %}
            {% endif %}
            {% if arg is ops_dat %}
            arg{{arg.id}}{{"," if not last_check}}
            {% elif arg is ops_gbl %}
            {{get_arg_gbl_name(arg)}}{{"," if not last_check}}
            {% endif %}
        {% endfor %}
        {% for const in consts %}
            {{const.ptr}}{{"," if not loop.last}}
        {% endfor %}
    );
#endif
    {% endif %}

}
