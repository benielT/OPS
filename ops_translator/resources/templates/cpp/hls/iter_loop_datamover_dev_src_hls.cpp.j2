                {% if config["datamover_lib"] == 1 %}
                    {% if config["tile_banks"] > 1 %}
        stridedTileStream2mem<mem_data_width, {{config["tile_banks"]}}, {{config["maxi_read_burst_length"]}}, {{II(arg)}}>(
                        {% for i in range(config["tile_banks"]) %}
