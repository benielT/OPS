{% if isTiling %}
static void datamover_outerloop_{{ilh.id}}_tile_config_wrapper(const ops::hls::MemConfigTile& memconfig,
    const unsigned short& tile_x,
    {% if ndim == 3 %}
    const unsigned short& tile_y,
    {% endif %}
    const unsigned short& stride_y,
    {% if ndim == 3 %}
    const unsigned short& stride_z,
    const unsigned short& z_diff,
    {% else %}
    const unsigned short& y_diff,
    {% endif %}
    unsigned int& num_pkts,
    unsigned int& num_beats,
    {% if prog.is_interleave() %}
        {% if ndim == 3 %}
    unsigned short& size_y,
    unsigned short& abs_row_offset,
        {% endif %}
    bool& is_small_tile,
    {% endif %}
    {% if ndim == 3 %}
    ap_uint<192>& command
    {% else %}
    ap_uint<144>& command
    {% endif %})
{
#pragma HLS INLINE
    const unsigned short tile_size_x = tile_x == (memconfig.tile_count_x -1) ? memconfig.last_tile_size_x : memconfig.tile_size_x;
    const ap_uint<64> tile_x_offset = tile_x * memconfig.effective_tile_size_x;
    {% if ndim == 3 %}
    abs_row_offset = tile_y * memconfig.effective_tile_size_y;
    const ap_uint<64> tile_y_offset = abs_row_offset * memconfig.grid_xblocks;
    const unsigned short tile_size_y = tile_y == (memconfig.tile_count_y -1) ? memconfig.last_tile_size_y : memconfig.tile_size_y;
    const ap_uint<64> offset = memconfig.start_offset + tile_x_offset + tile_y_offset;
    const unsigned int tile_size_y_mul_z_diff = tile_size_y * z_diff;
    const unsigned int total_beats = tile_size_x * tile_size_y_mul_z_diff;
    {% else %}
    const ap_uint<64> offset = memconfig.start_offset + tile_x_offset;
    const unsigned int total_beats = tile_size_x * y_diff;
    {% endif %}
    {% if prog.is_interleave() %}
    const unsigned int x_pkts = (tile_size_x + {{config["tile_banks"] -1}}) >> {{log2(config["tile_banks"])|int}};
        {% if ndim == 3 %}
    const unsigned int total_pkts = x_pkts * tile_size_y_mul_z_diff;
        {% else %}
    const unsigned int total_pkts = x_pkts * y_diff;
        {% endif %}
    {% else %}
    const unsigned int total_pkts = total_beats * num_of_pkts_per_beat;
    {% endif %}

    {% if ndim == 3 %}
    const unsigned int avoid_x = tile_x == 0 ? 0 : memconfig.tile_overlap_size_x >> 1;
    const unsigned int avoid_y = tile_y == 0 ? 0 : memconfig.tile_overlap_size_y >> 1;
    command = ops::hls::commandGen3D(offset, 1, (ap_uint<16>)tile_size_x, (ap_uint<16>)stride_y, (ap_int<16>)tile_size_y, 
            (ap_int<16>)stride_z, (ap_uint<16>)z_diff, (ap_uint<16>)avoid_x, (ap_uint<16>)avoid_y);
    {% else %}
    const unsigned int avoid_x = tile_x == 0 ? 0 : memconfig.tile_overlap_size_x >> 1;
    command = ops::hls::commandGen2D(offset, 1, (ap_uint<16>)tile_size_x, (ap_uint<16>)stride_y, (ap_int<16>)y_diff, (ap_uint<16>)avoid_x);
    {% endif %}

    num_pkts = total_pkts;
    num_beats = total_beats;
    {% if prog.is_interleave() %}
        {% if ndim == 3 %}
    size_y = tile_size_y;
        {% endif %}
    {#TODO: small tile case - need to be fixed
    is_small_tile = tile_size_x <= {{(config["tile_banks"]/2)|int}};#}
    is_small_tile = false;
    {% endif %} 

#ifdef DEBUG_LOG
    printf("[KERNEL_DEBUG]|datamover_%s| \n===============================\n","{{ilh.unique_name}}");
    printf("[KERNEL_DEBUG]|datamover_%s| total_beats: %d\n", "{{ilh.unique_name}}", total_beats);
    printf("[KERNEL_DEBUG]|datamover_%s| total_pkts: %d\n","{{ilh.unique_name}}", total_pkts);
    printf("[KERNEL_DEBUG]|datamover_%s| ===============================\n","{{ilh.unique_name}}");
    printf("[KERNEL_DEBUG]|datamover_%s| command:   \n","{{ilh.unique_name}}");
    printf("[KERNEL_DEBUG]|datamover_%s|    offset: %d  \n", "{{ilh.unique_name}}", offset);
    printf("[KERNEL_DEBUG]|datamover_%s|    tile_x: %d  \n","{{ilh.unique_name}}" , tile_size_x);
    printf("[KERNEL_DEBUG]|datamover_%s|    stride_x: %d  \n","{{ilh.unique_name}}" ,1);
    {% if ndim == 3 %}
    printf("[KERNEL_DEBUG]|datamover_%s|    tile_y: %d  \n","{{ilh.unique_name}}", tile_size_y);
    {% else %}
    printf("[KERNEL_DEBUG]|datamover_%s|    tile_y: %d  \n","{{ilh.unique_name}}", y_diff);
    {% endif %}
    printf("[KERNEL_DEBUG]|datamover_%s|    stride_y: %d  \n","{{ilh.unique_name}}", stride_y);
    {% if ndim == 3 %}
    printf("[KERNEL_DEBUG]|datamover_%s|    tile_z: %d  \n","{{ilh.unique_name}}" , z_diff);
    printf("[KERNEL_DEBUG]|datamover_%s|    stride_z: %d  \n","{{ilh.unique_name}}" , stride_z);
    {% endif %}
    printf("[KERNEL_DEBUG]|datamover_%s|    avoid_x: %d  \n","{{ilh.unique_name}}" , avoid_x);
    {% if ndim == 3 %}
    printf("[KERNEL_DEBUG]|datamover_%s|    avoid_y: %d  \n","{{ilh.unique_name}}", avoid_y);
    {% endif %}
    printf("[KERNEL_DEBUG]|datamover_%s| total_pkts: %d  \n","{{ilh.unique_name}}", total_pkts);
    printf("[KERNEL_DEBUG]|datamover_%s| total_beats: %d  \n","{{ilh.unique_name}}", total_beats);
    {% if prog.is_interleave() %}
    printf("[KERNEL_DEBUG]|datamover_%s|    x_pkts: %d  \n","{{ilh.unique_name}}", x_pkts);
    printf("[KERNEL_DEBUG]|datamover_%s|    is_small_tile: %d  \n","{{ilh.unique_name}}", is_small_tile);
    {% endif %}
    printf("[KERNEL_DEBUG]|datamover_%s| ===============================\n","{{ilh.unique_name}}");
#endif
}
{% endif %}

