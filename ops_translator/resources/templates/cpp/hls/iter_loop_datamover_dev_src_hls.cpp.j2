{% block datamover_dataflow_region %}
static void datamover_outerloop_{{ilh.id}}_dataflow_region_read(
        const unsigned int num_pkts,
    {#{% if ilh.isMultiDim() %}
        {% for m_dim in ilh.getMultidimList() %}
        const unsigned int num_pkts_d{{m_dim}},
        {% endfor %}
    {% endif %}#}
        const ops::hls::MemConfig& memconfig
    {%- if ilh.isMultiDim() -%}
        {%- for m_dim in ilh.getMultidimList() -%}
        ,{{"\n"}}        const ops::hls::MemConfig& memconfig_d{{m_dim}}
        {%- endfor -%}
    {%- endif -%}
    {#{%- for arg in ilh.joint_args|ops_dat -%}
        {%- if arg is ops_read or arg is ops_rw -%}
        ,{{"\n"}}       ops::hls::SizeType& arg{{arg.id}}_gridSize
        {%- endif -%}
    {%- endfor -%}#}
    {%- for arg in ilh.joint_args|ops_dat -%}
        {%- if arg is ops_read or arg is ops_rw -%}
        ,{{"\n"}}        ap_uint<mem_data_width>* arg{{arg.id}}
        {%- endif -%}
    {%- endfor -%}
    {%- for arg in ilh.joint_args|ops_dat -%}
        {%- if arg is ops_read -%}
        ,{{"\n"}}        hls::stream<ap_axiu<{{axis_data_width(arg)-}}, 0, 0, 0>>& {{axis_name(arg)}}
        {%- elif arg is ops_rw -%}
        ,{{"\n"}}        hls::stream<ap_axiu<{{axis_data_width(arg)-}}, 0, 0, 0>>& {{axis_name_t2(arg, "out")}}
        {%- endif -%}
    {%- endfor -%})
{
#pragma HLS DATAFLOW
    {% for arg in ilh.joint_args|ops_dat %}
        {% if arg is ops_read_or_rw%}
    static ::hls::stream<ap_uint<mem_data_width>> arg{{arg.id}}_read_mem_strm;
    #pragma HLS STREAM variable = arg{{arg.id}}_read_mem_strm depth = {{(config["maxi_read_burst_length"] * config["num_read_outstanding"]) | int}}
            {% if config["vector_factor"] * ilh.dats[arg.dat_id][0].dim < config["mem_vector_factor"] %}
    static ::hls::stream<ap_uint<{{axis_data_width(arg)-}}>> arg{{arg.id}}_read_reduced_mem_strm;
    #pragma HLS STREAM variable = arg{{arg.id}}_read_reduced_mem_strm depth = {{(config["maxi_read_burst_length"] * config["num_read_outstanding"] *  config["mem_vector_factor"] / config["vector_factor"]) | int}}
            {% endif %}
        {% endif %}
    {% endfor %}
    {% for arg in ilh.joint_args|ops_dat|ops_read_or_rw %}
    ops::hls::mem2stream<mem_data_width, 32, {{II(arg)}}>(arg{{arg.id}}, arg{{arg.id}}_read_mem_strm, {{memconfig(arg)}}.total_xblocks);
    {% endfor %}
    
    {% for arg in ilh.joint_args|ops_dat|ops_read_or_rw %}
        {% if config["vector_factor"] * ilh.dats[arg.dat_id][0].dim < config["mem_vector_factor"] %}
    ops::hls::stream2streamStepdown<mem_data_width, {{axis_data_width(arg)-}}>(arg{{arg.id}}_read_mem_strm, arg{{arg.id}}_read_reduced_mem_strm, {{num_beats(arg)}});
        {% endif %}
    {% endfor %}
    {% for arg in ilh.joint_args|ops_dat|ops_read_or_rw %}
        {% if config["vector_factor"] * ilh.dats[arg.dat_id][0].dim < config["mem_vector_factor"] %}
            {% if arg is ops_read %}
    ops::hls::stream2axis<{{axis_data_width(arg)-}}>(arg{{arg.id}}_read_reduced_mem_strm, {{axis_name(arg)}}, {{num_pkts(arg)}});
            {% elif arg is ops_rw %}
    ops::hls::stream2axis<{{axis_data_width(arg)-}}>(arg{{arg.id}}_read_reduced_mem_strm, {{axis_name_t2(arg, "out")}}, {{num_pkts(arg)}});
            {% endif %}
        {% else %}
            {% if arg is ops_read %}
    ops::hls::stream2axis<{{axis_data_width(arg)-}}>(arg{{arg.id}}_read_mem_strm, {{axis_name(arg)}}, {{num_pkts(arg)}});
            {% elif arg is ops_rw %}
    ops::hls::stream2axis<{{axis_data_width(arg)-}}>(arg{{arg.id}}_read_mem_strm, {{axis_name_t2(arg, "out")}}, {{num_pkts(arg)}});
            {% endif %}
        {% endif %}
    {% endfor %}
    {#{% for arg in ilh.joint_args|ops_dat %}
        {% if arg is ops_read %}
    ops::hls::memReadGridV2<mem_data_width, {{axis_data_width(arg)-}}, data_width>(arg{{arg.id}}, {{axis_name(arg)}}, arg{{arg.id}}_gridSize, range);
        {% elif arg is ops_rw %}
    ops::hls::memReadGridV2<mem_data_width, {{axis_data_width(arg)-}}, data_width>(arg{{arg.id}}, {{axis_name_t2(arg, "out")}}, arg{{arg.id}}_gridSize, range);
        {% endif %}
    {% endfor %}#}
}

static void datamover_outerloop_{{ilh.id}}_dataflow_region_write(
        const unsigned int num_pkts,
    {#{% if ilh.isMultiDim() %}
        {% for m_dim in ilh.getMultidimList() %}
        const unsigned int num_pkts_d{{m_dim}},
        {% endfor %}
    {% endif %}#}
        const ops::hls::MemConfig& memconfig
    {%- if ilh.isMultiDim() -%}
        {%- for m_dim in ilh.getMultidimList() -%}
        ,{{"\n"}}        const ops::hls::MemConfig& memconfig_d{{m_dim}}
        {%- endfor -%}
    {%- endif -%}
    {#ops::hls::AccessRange& range
    {%- for arg in ilh.joint_args|ops_dat -%}
        {%- if arg is ops_write or arg is ops_rw -%}
        ,{{"\n"}}       ops::hls::SizeType& arg{{arg.id}}_gridSize
        {%- endif -%}
    {%- endfor -%}#}
    {%- for arg in ilh.joint_args|ops_dat -%}
        {%- if arg is ops_write or arg is ops_rw -%}
        ,{{"\n"}}        ap_uint<mem_data_width>* arg{{arg.id}}
        {%- endif -%}
    {%- endfor -%}
    {%- for arg in ilh.joint_args|ops_dat -%}
        {%- if arg is ops_write -%}
        ,{{"\n"}}        hls::stream<ap_axiu<{{axis_data_width(arg)-}}, 0, 0, 0>>& {{axis_name(arg)}}
        {%- elif arg is ops_rw -%}
        ,{{"\n"}}        hls::stream<ap_axiu<{{axis_data_width(arg)-}}, 0, 0, 0>>& {{axis_name_t2(arg, "in")}}
        {%- endif -%}
    {%- endfor -%}
        )
{
    {% for arg in ilh.joint_args|ops_dat %}
        {% if arg is ops_write_or_rw and arg is not read_only_rw %}
    static ::hls::stream<ap_uint<mem_data_width>> arg{{arg.id}}_write_mem_strm;
    #pragma HLS STREAM variable = arg{{arg.id}}_write_mem_strm depth = {{(config["maxi_write_burst_length"] * config["num_write_outstanding"]) | int}}
            {% if config["vector_factor"] * ilh.dats[arg.dat_id][0].dim < config["mem_vector_factor"] %}
    static ::hls::stream<ap_uint<{{axis_data_width(arg)-}}>> arg{{arg.id}}_write_reduced_mem_strm;
    #pragma HLS STREAM variable = arg{{arg.id}}_write_reduced_mem_strm depth = {{(config["maxi_write_burst_length"] * config["num_write_outstanding"] *  config["mem_vector_factor"] / config["vector_factor"]) | int}}
            {% endif %}
        {% endif %}
    {% endfor %}

#pragma HLS DATAFLOW
    {% for arg in ilh.joint_args|ops_dat|ops_write_or_rw %}
        {% if arg is ops_write_or_rw %}
            {% if arg is read_only_rw %}
    ops::hls::axisTerminate<{{axis_data_width(arg)-}}>({{axis_name_t2(arg, "in")}}, {{num_pkts(arg)}});
            {% else %}
                {% if config["vector_factor"] * ilh.dats[arg.dat_id][0].dim < config["mem_vector_factor"] %}
                    {% if arg is ops_write %}
    ops::hls::axis2stream<{{axis_data_width(arg)-}}>({{axis_name(arg)}}, arg{{arg.id}}_write_reduced_mem_strm, {{num_pkts(arg)}});
                    {% else %}
    ops::hls::axis2stream<{{axis_data_width(arg)-}}>({{axis_name_t2(arg, "in")}}, arg{{arg.id}}_write_reduced_mem_strm, {{num_pkts(arg)}});
                    {% endif %}
                {% else %}
                    {% if arg is ops_write %}
    ops::hls::axis2stream<{{axis_data_width(arg)-}}>({{axis_name(arg)}}, arg{{arg.id}}_write_mem_strm, {{num_pkts(arg)}});
                    {% else %}
    ops::hls::axis2stream<{{axis_data_width(arg)-}}>({{axis_name_t2(arg, "in")}}, arg{{arg.id}}_write_mem_strm, {{num_pkts(arg)}});
                    {% endif %}
                {% endif %}
            {% endif %}
        {% endif %}    
    {% endfor %}
    {% for arg in ilh.joint_args|ops_dat|ops_write_or_rw %}
        {% if config["vector_factor"] * ilh.dats[arg.dat_id][0].dim < config["mem_vector_factor"] %}
            {% if arg is not read_only_rw %}
    ops::hls::stream2streamStepup<{{axis_data_width(arg)-}}, mem_data_width>(arg{{arg.id}}_write_reduced_mem_strm, arg{{arg.id}}_write_mem_strm, {{num_beats(arg)}});
            {% endif %}
        {% endif %}
    {% endfor %}
    {% for arg in ilh.joint_args|ops_dat|ops_write_or_rw %}
        {% if arg is not read_only_rw %}
    ops::hls::stream2mem<mem_data_width, 32, {{II(arg)}}>(arg{{arg.id}}, arg{{arg.id}}_write_mem_strm, {{memconfig(arg)}}.total_xblocks);
        {% endif %}
    {% endfor %}
    {#{% for arg in ilh.joint_args|ops_dat %}
        {% if arg is ops_write %}
    ops::hls::memWriteGridSimpleV2<mem_data_width, {{axis_data_width(arg)-}}, data_width>(arg{{arg.id}}, {{axis_name(arg)}}, arg{{arg.id}}_gridSize, range);
        {% elif arg is ops_rw %}
            {% if arg is read_only_rw %}
    ops::hls::memWriteGridTerminate<mem_data_width, {{axis_data_width(arg)-}}, data_width>({{axis_name_t2(arg, "in")}}, arg{{arg.id}}_gridSize, range);
            {% else %}
    ops::hls::memWriteGridSimpleV2<mem_data_width, {{axis_data_width(arg)-}}, data_width>(arg{{arg.id}}, {{axis_name_t2(arg, "in")}}, arg{{arg.id}}_gridSize, range);
            {% endif %}
        {% endif %}
    {% endfor %}#}
}

{% if isTiling and config["tile_banks"] > 1 %}
template <unsigned short MEM_DATA_WIDTH, unsigned short NUM_BANKS, unsigned short BURST_SIZE=32, unsigned short IN_ITR=2>
static void stridedTileMem2stream(
    {% for i in range(config["tile_banks"]) %}
        ap_uint<mem_data_width>* arg_b{{i}},
    {% endfor %}
    {% if ndim == 3 %}
        unsigned short abs_row_offset,
    {% endif %}
        unsigned short z_row_stride,
        ::hls::stream<ap_uint<MEM_DATA_WIDTH>>& strm_out, const ap_uint<{% if ndim == 3 %}160{% else %}128{% endif %}>& command )
{
    // #pragma HLS INLINE off
    #ifdef DEBUG_LOG
        printf("|HLS DEBUG_LOG|%s| reading tile from mem to stream \n", __func__);
    #endif

    //static ::hls::stream<ap_uint<MEM_DATA_WIDTH>> strm_internal("strm_internal");
	//#pragma HLS STREAM variable = strm_internal depth = {{(config["maxi_read_burst_length"] * config["num_read_outstanding"])|int}}

    const unsigned short NUM_BANKS_SHIFT = LOG2(NUM_BANKS);

    ap_uint<64> offset_x = command.range(63,0);
    ap_uint<16> size_x = command.range(95,80);
    ap_uint<16> stride_y = command.range(111,96);
    ap_uint<16> size_y = command.range(127,112);
    {% if ndim == 3 %}
    ap_uint<16> stride_z = command.range(143,128);
    ap_uint<16> size_z = command.range(159,144);

    for (unsigned short z = 0; z < size_z; z++)
    {
        #pragma HLS PIPELINE off
        unsigned short z_row_id_offset = abs_row_offset + z * z_row_stride;

    {% endif %}
    for (unsigned short y = 0; y < size_y; y++)
    {
        #pragma HLS PIPELINE off
        unsigned short abs_row_id_of_y = y {% if ndim == 3 %}+ z_row_id_offset{% endif %};
        unsigned short bank_id = abs_row_id_of_y % NUM_BANKS;
        ap_uint<64> per_bank_row = (ap_uint<64>)(abs_row_id_of_y >> NUM_BANKS_SHIFT);
        ap_uint<64> s2 = offset_x + per_bank_row * stride_y;
        #ifdef DEBUG_LOG
        {% if ndim == 3 %}
        printf("|HLS DEBUG_LOG|%s| z:%u y:%u abs_row_id:%u bank_id:%u  offset:%llu size_x:%u stride_y:%u size_y:%u stride_z:%u size_z:%u\n", 
                __func__, (unsigned int)z, (unsigned int)y, (unsigned int)abs_row_id_of_y, (unsigned int)bank_id, 
                (unsigned long long)s2, (unsigned int)size_x, (unsigned int)stride_y, (unsigned int)size_y, 
                (unsigned int)stride_z, (unsigned int)size_z);
        {% else %}
        printf("|HLS DEBUG_LOG|%s| y:%u abs_row_id:%u bank_id:%u  offset:%llu size_x:%u stride_y:%u size_y:%u \n", 
                __func__, (unsigned int)y, (unsigned int)abs_row_id_of_y, (unsigned int)bank_id, 
                (unsigned long long)s2, (unsigned int)size_x, (unsigned int)stride_y, (unsigned int)size_y);
        {% endif %}
        #endif
        {% for i in range(config["tile_banks"]) %}
            {% if loop.first %}
                    if (bank_id == {{i}})
                        ops::hls::mem2stream<MEM_DATA_WIDTH, BURST_SIZE, IN_ITR>(arg_b{{i}} + s2, strm_out, size_x);
            {% elif loop.last %}
                    else
                        ops::hls::mem2stream<MEM_DATA_WIDTH, BURST_SIZE, IN_ITR>(arg_b{{i}} + s2, strm_out, size_x);
            {% else %}
                    else if (bank_id == {{i}})
                        ops::hls::mem2stream<MEM_DATA_WIDTH, BURST_SIZE, IN_ITR>(arg_b{{i}} + s2, strm_out, size_x);
            {% endif %}
        {% endfor %}
    }
    {% if ndim == 3 %}
    }
    {% endif %}
}

template <unsigned short MEM_DATA_WIDTH, unsigned short NUM_BANKS, unsigned short BURST_SIZE=32, unsigned short IN_ITR=2>
static void stridedTileStream2memWithAvoid(
    {% for i in range(config["tile_banks"]) %}
        ap_uint<mem_data_width>* arg_b{{i}},
    {% endfor %}
    {% if ndim == 3 %}
        unsigned short abs_row_offset,
    {% endif %}
        unsigned short z_row_stride,
        ::hls::stream<ap_uint<MEM_DATA_WIDTH>>& strm_in, const ap_uint<{%if ndim == 3%}192{%else%}144{%endif%}>& command)
{
    //     // #pragma HLS INLINE off
    #ifdef DEBUG_LOG
        printf("|HLS DEBUG_LOG|%s| writing tile from stream to mem \n", __func__);
    #endif
    
    const unsigned short NUM_BANKS_SHIFT = LOG2(NUM_BANKS);

    ap_uint<64> offset_x = command.range(63,0);
    ap_uint<16> size_x = command.range(95,80);
    ap_uint<16> stride_y = command.range(111,96);
    ap_uint<16> size_y = command.range(127,112);
    {% if not ndim == 3 %}
    ap_uint<16> avoid_x = command.range(143,128);
    {% else %}
    ap_uint<16> stride_z = command.range(143,128);
    ap_uint<16> size_z = command.range(159,144);
	ap_uint<16> avoid_x = command.range(175,160);
	ap_uint<16> avoid_y = command.range(191,176);

    for (ap_uint<16> z = 0; z < size_z; z++)
    {
        #pragma HLS PIPELINE off
        unsigned short z_row_id_offset = abs_row_offset + z * z_row_stride;
    {% endif %}
        for (ap_uint<16> y = 0; y < size_y; y++)
        {
            #pragma HLS PIPELINE off
            // ap_uint<64> s2 = s3 + y * stride_y;
            unsigned short abs_row_id_of_y = y {% if ndim == 3%}+ z_row_id_offset{% endif %};
            unsigned short bank_id = abs_row_id_of_y % NUM_BANKS;
            // unsigned short j_shifted = abs_row_id_of_y >> NUM_BANKS_SHIFT;
            // unsigned short j_floor = j_shifted << NUM_BANKS_SHIFT;
            // bool access_cond = j_floor + bank_id < size_y;
            ap_uint<64> per_bank_row = (ap_uint<64>)(abs_row_id_of_y >> NUM_BANKS_SHIFT);
            ap_uint<64> s2 = offset_x + per_bank_row * stride_y;
            #ifdef DEBUG_LOG
            {% if ndim == 3 %}
                printf("|HLS DEBUG_LOG|%s| z:%u y:%u offset:%llu, size_x:%u, stride_y:%u, size_y:%u, stride_z:%u, size_z:%u avoid_x:%u avoid_y:%u\n", 
                       __func__, (unsigned int)z, (unsigned int)y, (unsigned long long)s2, (unsigned int)size_x, (unsigned int)stride_y, (unsigned int)size_y, 
                       (unsigned int)stride_z, (unsigned int)size_z, (unsigned int)avoid_x, (unsigned int)avoid_y);
            {% else %}
                printf("|HLS DEBUG_LOG|%s| y:%u offset:%llu, size_x:%u, stride_y:%u, size_y:%u, avoid_x:%u \n", 
                       __func__, (unsigned int)y, (unsigned long long)s2, (unsigned int)size_x, (unsigned int)stride_y, (unsigned int)size_y, 
                        (unsigned int)avoid_x);
            {% endif %}
            #endif
    {% if ndim == 3 %}
			if (y < avoid_y)
				ops::hls::hlsTerminate<MEM_DATA_WIDTH, IN_ITR>(strm_in, size_x);
    {% endif %}
    {% for i in range(config["tile_banks"]) %}
        {% if loop.first and ndim != 3 %}
            if (bank_id == {{i}})
                ops::hls::stream2memWithAvoid<MEM_DATA_WIDTH, BURST_SIZE, IN_ITR>(arg_b{{i}} + s2, strm_in, size_x, avoid_x);
        {% elif loop.last %}
            else
                ops::hls::stream2memWithAvoid<MEM_DATA_WIDTH, BURST_SIZE, IN_ITR>(arg_b{{i}} + s2, strm_in, size_x, avoid_x);
        {% else %}
            else if (bank_id == {{i}}) 
                ops::hls::stream2memWithAvoid<MEM_DATA_WIDTH, BURST_SIZE, IN_ITR>(arg_b{{i}} + s2, strm_in, size_x, avoid_x);
        {% endif %}
    {% endfor %}
        }
    {% if ndim == 3 %}
    }
    {% endif %}
}
{% endif %}

static void datamover_outerloop_{{ilh.id}}_dataflow_read_write_dataflow_region(
        const unsigned int num_pkts,
    {#% if not isTiling %}
        {% if ilh.isMultiDim() %}
            {% for m_dim in ilh.getMultidimList() %}
        const unsigned int num_pkts_d{{m_dim}},
            {% endfor %}
        {% endif %}
    {% endif %#}
    {% if isTiling %}
        const unsigned int num_beats,
        {% if prog.is_interleave() %}
        const unsigned int size_y,
            {% if ndim == 3 %}
        const unsigned int size_z,
            {% endif %}
        const bool is_small_tile,
        const unsigned int small_tile_pkts,
        {% endif %}
        {% if ndim == 3 %}
        ap_uint<192>& command,
        ap_uint<160>& short_command,
        {% else %}
        ap_uint<144>& command,
        ap_uint<128>& short_command,
        {% endif %}
        {% if config["tile_banks"] > 1 %}
            {% if ndim == 3 %}
        unsigned short abs_row_offset,
            {% endif %}
        unsigned short z_row_stride,
        {% endif %}
    {% else %}
        const ops::hls::MemConfig& memconfig,
        {% if ilh.isMultiDim() %}
            {% for m_dim in ilh.getMultidimList() %}
        const ops::hls::MemConfig& memconfig_d{{m_dim}},
            {% endfor %}
        {% endif %}
    {% endif %}
    {% for arg in ilh.joint_args|ops_dat %}
        {% if config["datamover_lib"] == 1 %}
            {% if isTiling and config["tile_banks"] > 1 %}
                {% for i in range(config["tile_banks"]) %}
        ap_uint<mem_data_width>* arg{{(arg.id)}}_b{{i}},
                {% endfor %}
            {% else %}
        ap_uint<mem_data_width>* arg{{(arg.id)}},
            {% endif %}
        {% else %}
        ::hls::burst_maxi<ap_uint<mem_data_width>>& arg{{(arg.id)}},
        {% endif %}
    {% endfor %}
        {{axis_parameter_set()}})    
{
    #pragma HLS DATAFLOW
    {% for arg in ilh.joint_args|ops_dat %}
        {% if arg is ops_read_or_rw%}
            {% if prog.is_interleave() %}
    static ::hls::stream<ap_uint<48>> arg{{arg.id}}_read_command_strm[{{config["tile_banks"]}}];
    #pragma HLS STREAM variable = arg{{arg.id}}_read_command_strm depth = 2
    static ::hls::stream<ap_uint<mem_data_width>> arg{{arg.id}}_read_mem_redirect_strm[{{config["tile_banks"]}}];
    #pragma HLS STREAM variable = arg{{arg.id}}_read_mem_redirect_strm depth = 10    
            {% endif %}
    static ::hls::stream<ap_uint<mem_data_width>> arg{{arg.id}}_read_mem_strm{%if prog.is_interleave()%}[{{config["tile_banks"]}}]{%endif%};
    #pragma HLS STREAM variable = arg{{arg.id}}_read_mem_strm depth = {{(config["maxi_read_burst_length"] * config["num_read_outstanding"])|int}}
            {% if config["vector_factor"] * ilh.dats[arg.dat_id][0].dim < config["mem_vector_factor"] %}
    static ::hls::stream<ap_uint<{{axis_data_width(arg)-}}>> arg{{arg.id}}_read_reduced_mem_strm{%if prog.is_interleave()%}[{{config["tile_banks"]}}]{%endif%};
    #pragma HLS STREAM variable = arg{{arg.id}}_read_reduced_mem_strm depth = {{(config["maxi_read_burst_length"] * config["num_read_outstanding"] *  config["mem_vector_factor"] / config["vector_factor"])|int}}
            {% endif %}
        {% endif %}
        {% if arg is ops_write_or_rw and arg is not read_only_rw %}
            {% if config["vector_factor"] * ilh.dats[arg.dat_id][0].dim < config["mem_vector_factor"] %}
    static ::hls::stream<ap_uint<{{axis_data_width(arg)-}}>> arg{{arg.id}}_write_reduced_mem_strm{%if prog.is_interleave()%}[{{config["tile_banks"]}}]{%endif%};
    #pragma HLS STREAM variable = arg{{arg.id}}_write_reduced_mem_strm depth = {{(config["maxi_write_burst_length"] * config["num_write_outstanding"] *  config["mem_vector_factor"] / config["vector_factor"])|int}}
            {% endif %}
    static ::hls::stream<ap_uint<mem_data_width>> arg{{arg.id}}_write_mem_strm{%if prog.is_interleave()%}[{{config["tile_banks"]}}]{%endif%};
    #pragma HLS STREAM variable = arg{{arg.id}}_write_mem_strm depth = {{(config["maxi_write_burst_length"] * config["num_write_outstanding"])|int}}
        {% endif %}
        {% if prog.is_interleave() %}
    static ::hls::stream<ap_uint<mem_data_width>> arg{{arg.id}}_write_mem_redirect_strm[{{config["tile_banks"]}}];
    #pragma HLS STREAM variable = arg{{arg.id}}_write_mem_redirect_strm depth = 10
    static ::hls::stream<ap_uint<64>> arg{{arg.id}}_write_command_strm[{{config["tile_banks"]}}];
    #pragma HLS STREAM variable = arg{{arg.id}}_write_command_strm depth = 2    
        {% endif %}
    {% endfor %}


    {% for arg in ilh.joint_args|ops_dat|ops_read_or_rw %}
        {% if isTiling %}
        //ops::hls::mem2streamTiled<mem_data_width, {{config["maxi_read_burst_length"]}}, {{II(arg)}}>(arg{{arg.id}}_b1, arg{{arg.id}}_b2, arg{{arg.id}}_read_mem_strm, memconfig);
