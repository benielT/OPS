        ap_uint<mem_data_width>* arg{{(arg.id)}}_b{{i}},
            {% endfor %}
        {% else %}
        ap_uint<mem_data_width>* arg{{(arg.id)}},
        {% endif %}
    {% else %}
        ::hls::burst_maxi<ap_uint<mem_data_width>>& arg{{(arg.id)}},
    {% endif %}
        {#{% endif %}#}
    {% endfor %}
    {% for arg in ilh.joint_args|ops_dat %}
        {% if (arg is not ops_rw) and arg is is_arg_swap(ilh) %}
        hls::stream <ap_axiu<{{axis_data_width(arg)-}},0,0,0>>& {{axis_name(arg)-}}{{"," if not loop.last}}
        {% else %}
        hls::stream <ap_axiu<{{axis_data_width(arg)-}},0,0,0>>& {{axis_name_t2(arg, "out")-}},
        hls::stream <ap_axiu<{{axis_data_width(arg)-}},0,0,0>>& {{axis_name_t2(arg, "in")-}}{{"," if not loop.last}}
        {% endif %}
    {% endfor %})    
{
    {% if isTiling %}
        {%if ndim == 3 %}
    const unsigned short total_tiles = memconfig.tile_count_x * memconfig.tile_count_y;
    const unsigned short z_diff = memconfig.end_z - memconfig.start_z;
    const unsigned short stride_z = memconfig.grid_xblocks * memconfig.grid_size_y;
	unsigned short tile_y = 0;
        {% else %}
    const unsigned short total_tiles = memconfig.tile_count_x;
    const unsigned short y_diff = memconfig.end_y - memconfig.start_y;
        {% endif %}
	unsigned short tile_x = 0;
	const unsigned short stride_y = memconfig.grid_xblocks;
    {% endif %}

    for (unsigned int i = 0; i < iter/2; i++)
    {
    //#pragma HLS PIPELINE REWIND
    #ifdef DEBUG_LOG
        printf("[KERNEL_DEBUG]|%s| Calling datamover. i:%d\n", __func__, i);
    #endif
    {% if isTiling %}
        for (unsigned short tile_id = 0; tile_id < total_tiles; tile_id++)
		{
            if (tile_id > 0) {
				tile_x++;
				if (tile_x >= memconfig.tile_count_x) {
					tile_x = 0;
                {% if ndim == 3 %}
					tile_y++;
                {% endif %}
				}
			}

            const unsigned short tile_size_x = tile_x == (memconfig.tile_count_x -1) ? memconfig.last_tile_size_x : memconfig.tile_size_x;
			const ap_uint<64> tile_x_offset = tile_x * memconfig.effective_tile_size_x;
        {% if ndim == 3 %}
			const ap_uint<64> tile_y_offset = tile_y * memconfig.effective_tile_size_y * memconfig.grid_xblocks;
			const unsigned short tile_size_y = tile_y == (memconfig.tile_count_y -1) ? memconfig.last_tile_size_y : memconfig.tile_size_y;
            const ap_uint<64> offset = memconfig.start_offset + tile_x_offset + tile_y_offset;
            const unsigned int total_beats = tile_size_x * tile_size_y * z_diff;
        {% else %}
            onst ap_uint<64> offset = memconfig.start_offset + tile_x_offset;
            const unsigned int total_beats = tile_size_x * y_diff;
        {% endif %}
			const unsigned int total_pkts = total_beats * num_of_pkts_per_beat;

        {% if ndim == 3 %}
            const unsigned int avoid_x = tile_x == 0 ? 0 : memconfig.tile_overlap_size_x >> 1;
            const unsigned int avoid_y = tile_y == 0 ? 0 : memconfig.tile_overlap_size_y >> 1;
            auto command = ops::hls::commandGen3D(offset, 1, (ap_uint<16>)tile_size_x, (ap_uint<16>)stride_y, (ap_int<16>)tile_size_y, 
                    (ap_int<16>)stride_z, (ap_uint<16>)z_diff, (ap_uint<16>)avoid_x, (ap_uint<16>)avoid_y);

        {% else %}
            const unsigned int avoid_x = tile_x == 0 ? 0 : memconfig.tile_overlap_size_x >> 1;
            auto command = ops::hls::commandGen2D(offset, 1, (ap_uint<16>)tile_size_x, (ap_uint<16>)stride_y, (ap_uint<16>)avoid_x);
            
		{% endif %}
    {% endif %}
            datamover_outerloop_{{ilh.id}}_dataflow_read_write_dataflow_region(
    {% if isTiling %}
                    total_pkts,
                    total_beats,
    {% else %}
                    num_pkts,
    {% endif %}
            {#{% if ilh.isMultiDim() %}
                {% for m_dim in ilh.getMultidimList() %}
                num_pkts_d{{m_dim}},
                {% endfor %}
            {% endif %}#}
    {% if isTiling %}
                    command,
    {% else %}
                    memconfig,
        {% if ilh.isMultiDim() %}
            {% for m_dim in ilh.getMultidimList() %}
                    memconfig_d{{m_dim}},
            {% endfor %}
        {% endif %}
    {% endif %}
    {% for arg in ilh.joint_args|ops_dat %}
        {% if isTiling and config["tile_banks"] > 1 and config["datamover_lib"] == 1 %}
            {% for i in range(config["tile_banks"]) %}
                    arg{{(arg.id)}}_b{{i}},
            {% endfor %}
        {% else %}
                    arg{{(arg.id)}},
        {% endif %}
    {% endfor %}
    {% for arg in ilh.joint_args|ops_dat %}
        {% if (arg is not ops_rw) and arg is is_arg_swap(ilh) %}
                    {{axis_name(arg)-}}{{"," if not loop.last}}
        {% else %}
                    {{axis_name_t2(arg, "out")-}},
                    {{axis_name_t2(arg, "in")-}}{{"," if not loop.last}}
        {% endif %}
    {% endfor %}
            );
    {% if isTiling %}
        }

        tile_x = 0;
        {% if ndim == 3 %}
        tile_y = 0;

        {% endif %}
        for (unsigned short tile_id = 0; tile_id < total_tiles; tile_id++)
		{
            if (tile_id > 0) {
				tile_x++;
				if (tile_x >= memconfig.tile_count_x) {
					tile_x = 0;
                {% if ndim == 3 %}
					tile_y++;
                {% endif %}
				}
			}

            const unsigned short tile_size_x = tile_x == (memconfig.tile_count_x -1) ? memconfig.last_tile_size_x : memconfig.tile_size_x;
			const ap_uint<64> tile_x_offset = tile_x * memconfig.effective_tile_size_x;
        {% if ndim == 3 %}
			const ap_uint<64> tile_y_offset = tile_y * memconfig.effective_tile_size_y * memconfig.grid_xblocks;
			const unsigned short tile_size_y = tile_y == (memconfig.tile_count_y -1) ? memconfig.last_tile_size_y : memconfig.tile_size_y;
            const ap_uint<64> offset = memconfig.start_offset + tile_x_offset + tile_y_offset;
            const unsigned int total_beats = tile_size_x * tile_size_y * z_diff;
        {% else %}
            onst ap_uint<64> offset = memconfig.start_offset + tile_x_offset;
            const unsigned int total_beats = tile_size_x * y_diff;
        {% endif %}
			const unsigned int total_pkts = total_beats * num_of_pkts_per_beat;

        {% if ndim == 3 %}
            const unsigned int avoid_x = tile_x == 0 ? 0 : memconfig.tile_overlap_size_x >> 1;
            const unsigned int avoid_y = tile_y == 0 ? 0 : memconfig.tile_overlap_size_y >> 1;
            auto command = ops::hls::commandGen3D(offset, 1, (ap_uint<16>)tile_size_x, (ap_uint<16>)stride_y, (ap_int<16>)tile_size_y, 
                    (ap_int<16>)stride_z, (ap_uint<16>)z_diff, (ap_uint<16>)avoid_x, (ap_uint<16>)avoid_y);

        {% else %}
            const unsigned int avoid_x = tile_x == 0 ? 0 : memconfig.tile_overlap_size_x >> 1;
            auto command = ops::hls::commandGen2D(offset, 1, (ap_uint<16>)tile_size_x, (ap_uint<16>)stride_y, (ap_int<16>)y_diff, (ap_uint<16>)avoid_x);

		{% endif %}
    {% endif %}
            datamover_outerloop_{{ilh.id}}_dataflow_read_write_dataflow_region(
     {% if isTiling %}
                    total_pkts,
                    total_beats,
    {% else %}
                    num_pkts,
    {% endif %}
                {#{% if ilh.isMultiDim() %}
                    {% for m_dim in ilh.getMultidimList() %}
                num_pkts_d{{m_dim}},
                    {% endfor %}
                {% endif %}#}
    {% if isTiling %}
                    command,
    {% else %}
                    memconfig,
        {% if ilh.isMultiDim() %}
            {% for m_dim in ilh.getMultidimList() %}
                    memconfig_d{{m_dim}},
            {% endfor %}
        {% endif %}
    {% endif %}
    {% for arg in ilh.joint_args|ops_dat %}
        {% if isTiling and config["tile_banks"] > 1 and config["datamover_lib"] == 1 %}
            {% for i in range(config["tile_banks"]) %}
                    arg{{ilh.getSwapArg(arg).id}}_b{{i}},
            {% endfor %}
        {% else %}
                    arg{{ilh.getSwapArg(arg).id}},
        {% endif %}
    {% endfor %}
    {% for arg in ilh.joint_args|ops_dat %}
        {% if (arg is not ops_rw) and arg is is_arg_swap(ilh) %}
                    {{axis_name(arg)-}}{{"," if not loop.last}}
        {% else %}
                    {{axis_name_t2(arg, "out")-}},
                    {{axis_name_t2(arg, "in")-}}{{"," if not loop.last}}
        {% endif %}
    {% endfor -%}
            );
    {% if isTiling %}
        }
    {% endif %}
    }
