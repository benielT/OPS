            {% for m_dim in ilh.getMultidimList() %}
    ops::hls::MemConfigTile config_d{{m_dim}};
            {% endfor %} 
        {% endif %} #}

    ops::hls::genMemConfigTileV2<mem_data_width, data_width>(read_gridSize, range, tile_size, tile_count, overlap_size, effective_tile_size, last_tile_size, total_xblocks, config);   
    {% else %}
    ops::hls::MemConfig config;
        {% if ilh.isMultiDim() %}
            {% for m_dim in ilh.getMultidimList() %}
    ops::hls::MemConfig config_d{{m_dim}};
            {% endfor %}
        {% endif %}
    ops::hls::genMemConfig<mem_data_width, axis_data_width, data_width>(read_gridSize, range, config, batch_size);
        {% if ilh.isMultiDim() %}
            {% for m_dim in ilh.getMultidimList() %}
    ops::hls::multidimConfigConverter<{{m_dim}}>(config, config_d{{m_dim}});
            {% endfor %}
        {% endif %}
    {% endif %}
    const unsigned int num_beats = config.total_xblocks;
    const unsigned int num_pkts = num_of_pkts_per_beat * num_beats;
