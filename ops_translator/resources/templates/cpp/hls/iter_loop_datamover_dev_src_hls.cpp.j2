    {% if config["datamover_mode"] == 3 or config["datamover_mode"] == 1 %}
static void datamover_outerloop_{{ilh.id}}_loopback_dataflow_region(
        const unsigned int num_pkts
    {#{%- if ilh.isMultiDim() -%}
        {%- for m_dim in ilh.getMultidimList() -%}
        ,{{"\n"}}        const unsigned int num_pkts_d{{m_dim}}
        {%- endfor -%}
    {%- endif -%}#}
    {%- for arg in ilh.joint_args|ops_dat -%}
    {%- if (arg is not ops_rw) and arg is is_arg_swap(ilh) -%}
        ,{{"\n"}}        hls::stream<ap_axiu<{{axis_data_width(arg)-}}, 0, 0, 0>>& {{axis_name(arg)}}
        {%- else -%}
        ,{{"\n"}}        hls::stream<ap_axiu<{{axis_data_width(arg)-}}, 0, 0, 0>>& {{axis_name_t2(arg, "out")}},
           hls::stream<ap_axiu<{{axis_data_width(arg)-}}, 0, 0, 0>>& {{axis_name_t2(arg, "in")}}
        {%- endif -%}
    {%- endfor -%}
        )
{
    {% for arg in ilh.joint_args|ops_dat %}
        {% if arg is ops_read or arg is ops_rw %}
    ::hls::stream<ap_uint<{{axis_data_width(arg)-}}>> arg{{arg.id}}_mem_strm;
    #pragma HLS STREAM variable = arg{{arg.id}}_mem_strm
        {% endif %}
    {% endfor %}
#pragma HLS DATAFLOW
    {% for arg in ilh.joint_args|ops_dat %}
        {% if arg is ops_read or arg is ops_rw %}
    ops::hls::axis2stream<{{axis_data_width(arg)-}}>(arg{{ilh.getSwapArg(arg).id}}_axis_in, arg{{arg.id}}_mem_strm, {{num_pkts(arg)}});
        {% endif %}
    {% endfor %}
    {% for arg in ilh.joint_args|ops_dat %}
        {% if arg is ops_read or arg is ops_rw %}
    ops::hls::stream2axis<{{axis_data_width(arg)-}}>(arg{{arg.id}}_mem_strm, arg{{arg.id}}_axis_out, {{num_pkts(arg)}});
        {% endif %}
    {% endfor %}
    {#{% for arg in ilh.joint_args|ops_dat %}
        {% if arg is ops_read or arg is ops_rw %}
        ops::hls::axisLoopbackV2<mem_data_width, {{axis_data_width(arg)-}}, data_width>(arg{{ilh.getArg(ilh.dat_swap_map[arg.dat_id]).id}}_axis_in, arg{{arg.id}}_axis_out, num_pkts);
        {% endif %}
    {% endfor %}#}
}

static void datamover_outerloop_{{ilh.id}}_loopback(
        const unsigned int iter,
        const unsigned int num_pkts
    {#{%- if ilh.isMultiDim() -%}
        {%- for m_dim in ilh.getMultidimList() -%}
        ,{{"\n"}}        const unsigned int num_pkts_d{{m_dim}}
        {%- endfor -%}
    {%- endif -%}#}
    {%- for arg in ilh.joint_args|ops_dat -%}
    {%- if (arg is not ops_rw) and arg is is_arg_swap(ilh) -%}
        ,{{"\n"}}        hls::stream<ap_axiu<{{axis_data_width(arg)-}}, 0, 0, 0>>& {{axis_name(arg)}}
        {%- else -%}
        ,{{"\n"}}        hls::stream<ap_axiu<{{axis_data_width(arg)-}}, 0, 0, 0>>& {{axis_name_t2(arg, "out")}},
            hls::stream<ap_axiu<{{axis_data_width(arg)-}}, 0, 0, 0>>& {{axis_name_t2(arg, "in")}}
        {%- endif -%}
    {%- endfor -%}
        )
{
    for (unsigned int i = 0; i < iter; i++)
    {
     //   pragma HLS PIPELINE REWIND
    #ifdef DEBUG_LOG
        printf("[KERNEL_DEBUG]|%s| Calling loopback. i:%d\n", __func__, i);
    #endif
        datamover_outerloop_{{ilh.id}}_loopback_dataflow_region(num_pkts
        {#{%- if ilh.isMultiDim() -%}
            {%- for m_dim in ilh.getMultidimList() -%}
                ,{{"\n"}}        num_pkts_d{{m_dim}}
            {%- endfor -%}
        {%- endif -%}#}
        {%- for arg in ilh.joint_args|ops_dat -%}
            {%- if (arg is not ops_rw) and arg is is_arg_swap(ilh) -%}
                ,{{"\n"}}        {{axis_name(arg)}}
            {%- else -%}
                ,{{"\n"}}        {{axis_name_t2(arg, "out")}}, {{axis_name_t2(arg, "in")}}
            {%- endif -%}
        {%- endfor -%}
        );
    } 
}
    {% endif %}
{% endblock %}

{% block datamover_prototype %}
{{super()}}
{% endblock %}
{% block datamover_body %}
{
    {% if config["datamover_mode"] == 3 %}
    #pragma HLS INTERFACE s_axilite port = is_loopback bundle = control
    {% endif %}
    {% for i in range(ndim) %}
    #pragma HLS INTERFACE s_axilite port = range_start_{{i}} bundle = control
    #pragma HLS INTERFACE s_axilite port = range_end_{{i}} bundle = control
    {% endfor %} 
    {% for i in range(ndim) %}
    #pragma HLS INTERFACE s_axilite port = gridSize_{{i}} bundle = control
    {% endfor %}
    #pragma HLS INTERFACE s_axilite port = outer_itr bundle = control
    {% if isTiling %}
        {% if ndim == 3 %}
    #pragma HLS INTERFACE s_axilite port = tile_size_x bundle = control
    #pragma HLS INTERFACE s_axilite port = tile_size_y bundle = control
    #pragma HLS INTERFACE s_axilite port = overlap_size_x bundle = control
    #pragma HLS INTERFACE s_axilite port = overlap_size_y bundle = control
    #pragma HLS INTERFACE s_axilite port = effective_tile_size_x bundle = control
    #pragma HLS INTERFACE s_axilite port = effective_tile_size_y bundle = control
    #pragma HLS INTERFACE s_axilite port = last_tile_size_x bundle = control
    #pragma HLS INTERFACE s_axilite port = last_tile_size_y bundle = control
    #pragma HLS INTERFACE s_axilite port = tile_count_x bundle = control
    #pragma HLS INTERFACE s_axilite port = tile_count_y bundle = control
        {% else %}
    #pragma HLS INTERFACE s_axilite port = tile_size_x bundle = control
    #pragma HLS INTERFACE s_axilite port = overlap_size_x bundle = control
    #pragma HLS INTERFACE s_axilite port = effective_tile_size_x bundle = control
    #pragma HLS INTERFACE s_axilite port = last_tile_size_x bundle = control
    #pragma HLS INTERFACE s_axilite port = tile_count_x bundle = control
        {% endif %}
    #pragma HLS INTERFACE s_axilite port = total_xblocks bundle = control
    {% else%}
    #pragma HLS INTERFACE s_axilite port = batch_size bundle = control
    {% endif %}
    {% for arg in ilh.joint_args|ops_dat %} 
        {% if isTiling %}
            {% if config["datamover_lib"] == 1 and config["tile_banks"] > 1 %}
                {% for i in range(config["tile_banks"]) %}
    #pragma HLS INTERFACE mode=m_axi bundle=gmem{{(arg.id * config["tile_banks"]|int + i) % 32}} depth={{config["maxi_depth"]}} max_read_burst_length={{config["maxi_read_burst_length"]}} max_write_burst_length={{config["maxi_write_burst_length"]}} \
            num_read_outstanding={{config["num_read_outstanding"]}} num_write_outstanding={{config["num_write_outstanding"]}} \
            port=arg{{arg.id}}_b{{i}} offset={{config["maxi_offset"]}} latency={{config["maxi_latency"]}}
    #pragma HLS INTERFACE s_axilite port = arg{{arg.id}}_b{{i}} bundle = control
                {% endfor %}
            {% else %}
    #pragma HLS INTERFACE mode=m_axi bundle=gmem{{arg.id}} depth={{config["maxi_depth"]}} max_read_burst_length={{config["maxi_read_burst_length"]}} max_write_burst_length={{config["maxi_write_burst_length"]}} \
            num_read_outstanding={{config["num_read_outstanding"]}} num_write_outstanding={{config["num_write_outstanding"]}} \
            port=arg{{arg.id}} offset={{config["maxi_offset"]}} latency={{config["maxi_latency"]}}
    #pragma HLS INTERFACE s_axilite port = arg{{arg.id}} bundle = control
            {% endif %}
    {##pragma HLS INTERFACE mode=m_axi bundle=gmem{{arg.id * 2 + 1}} depth={{config["maxi_depth"]}} max_read_burst_length={{config["maxi_read_burst_length"]}} max_write_burst_length={{config["maxi_write_burst_length"]}} \
            num_read_outstanding={{config["num_read_outstanding"]}} num_write_outstanding={{config["num_write_outstanding"]}} \
            port=arg{{arg.id}}_b2 offset={{config["maxi_offset"]}}#}
    {#pragma HLS INTERFACE s_axilite port = arg{{arg.id}}_b2 bundle = control#}
        {% else %}
    #pragma HLS INTERFACE mode=m_axi bundle=gmem{{arg.id}} depth={{config["maxi_depth"]}} max_read_burst_length={{config["maxi_read_burst_length"]}} max_write_burst_length={{config["maxi_write_burst_length"]}} \
            num_read_outstanding={{config["num_read_outstanding"]}} num_write_outstanding={{config["num_write_outstanding"]}} \
            port=arg{{arg.id}} offset={{config["maxi_offset"]}} latency={{config["maxi_latency"]}}
    #pragma HLS INTERFACE s_axilite port = arg{{arg.id}} bundle = control
        {% endif %}
    {% endfor %}
    {% for arg in ilh.joint_args|ops_dat %}
        {% if (arg is not ops_rw) and arg is is_arg_swap(ilh) %}
            {% if prog.is_interleave() %}
                {% for tile in range(config["tile_banks"]) %}
    #pragma HLS INTERFACE mode=axis port={{axis_name_t3(arg, tile)}} register register_mode=both
                {% endfor %}
            {% else %}
    #pragma HLS INTERFACE mode=axis port={{axis_name(arg)}} register register_mode=both
            {% endif %}
        {% else %}
            {% if prog.is_interleave() %}
                {% for tile in range(config["tile_banks"]) %}
    #pragma HLS INTERFACE mode=axis port={{axis_name_t3(arg, tile, "out")}} register register_mode=both
                {% endfor %}
                {% for tile in range(config["tile_banks"]) %}
    #pragma HLS INTERFACE mode=axis port={{axis_name_t3(arg, tile, "in")}} register register_mode=both
                {% endfor %}
            {% else %}
    #pragma HLS INTERFACE mode=axis port={{axis_name_t2(arg, "out")}} register register_mode=both
    #pragma HLS INTERFACE mode=axis port={{axis_name_t2(arg, "in")}} register register_mode=both
            {% endif %}
        {% endif %}
    {% endfor %}

    #pragma HLS INTERFACE s_axilite port=return bundle = control
    #pragma HLS INTERFACE ap_ctrl_chain port=return

    ops::hls::AccessRange range;
    {#{% if ilh.isMultiDim() %}
        {% for m_dim in ilh.getMultidimList() %}
    ops::hls::AccessRange range_d{{m_dim}};
        {% endfor %}
    {% endif %}#}
    {% for i in range(ndim) %}
    range.start[{{i}}] = range_start_{{i}};
    range.end[{{i}}] = range_end_{{i}};
    {% endfor%}
    range.dim = {{ndim}};
    {#{% if ilh.isMultiDim() %}
        {% for m_dim in ilh.getMultidimList() %}
            {% for i in range(ndim) %}
                {% if i == 0 %}
    range_d{{m_dim}}.start[{{i}}] = range_start_{{i}} * {{m_dim}};
    range_d{{m_dim}}.end[{{i}}] = range_end_{{i}} * {{m_dim}};
                {% else %}
    range_d{{m_dim}}.start[{{i}}] = range_start_{{i}};
    range_d{{m_dim}}.end[{{i}}] = range_end_{{i}};
                {% endif %}
            {% endfor%}
    range_d{{m_dim}}.dim = {{ndim}};
        {% endfor %}
    {% endif %}#}

    ops::hls::SizeType read_gridSize = { {% for i in range(config["ops_max_dim"]) -%}{% if i < ndim %}gridSize_{{i}}{{", " if (not loop.last)}}{% else %}1{{", " if (not loop.last)}}{% endif %}{% endfor %} };
    {#{% if ilh.isMultiDim() %}
        {% for m_dim in ilh.getMultidimList() %}    
    unsigned short gridSize_0_d{{m_dim}} = gridSize_0 * {{m_dim}};
    ops::hls::SizeType read_gridSize_d{{m_dim}} = { {% for i in range(config["ops_max_dim"]) -%}{% if i < ndim %}gridSize_{{i}}{{"_d" if i == 0}}{{m_dim if i == 0}}{{", " if (not loop.last)}}{% else %}1{{", " if (not loop.last)}}{% endif %}{% endfor %} };
        {% endfor %}
    {% endif %}#}
    {% if not isTiling %}
    unsigned int loopback_itr = outer_itr - 1 >= 0 ? outer_itr - 1 : 0;
    {% else %}
    ops::hls::SizeType2d tile_size = {tile_size_x, {{"tile_size_y" if ndim > 2 else "1"}}};
    ops::hls::SizeType2d overlap_size = {overlap_size_x, {{"overlap_size_y" if ndim > 2 else "1"}}};
    ops::hls::SizeType2d effective_tile_size = {effective_tile_size_x, {{"effective_tile_size_y" if ndim > 2 else "1"}}};
    ops::hls::SizeType2d last_tile_size = {last_tile_size_x, {{"last_tile_size_y" if ndim > 2 else "1"}}};
    ops::hls::SizeType2d tile_count = {tile_count_x, {{"tile_count_y" if ndim > 2 else "1"}}};
    {% endif %}

#ifdef DEBUG_LOG
    printf("[KERNEL_DEBUG]|%s| starting datamover TOP range:(%d,%d,%d) ---> (%d,%d,%d)\n", __func__,
            range.start[0], range.start[1], range.start[2], range.end[0], range.end[1], range.end[2]);
    {#{% if ilh.isMultiDim() %}
        {% for m_dim in ilh.getMultidimList() %}
    printf("[KERNEL_DEBUG]|%s| starting datamover TOP range_d{{m_dim}}:(%d,%d,%d) ---> (%d,%d,%d)\n", __func__,
            range_d{{m_dim}}.start[0], range_d{{m_dim}}.start[1], range_d{{m_dim}}.start[2], range_d{{m_dim}}.end[0], range_d{{m_dim}}.end[1], range_d{{m_dim}}.end[2]);
        {% endfor %}
    {% endif %}#}
    printf("[KERNEL_DEBUG]|%s| read_gridSize: (%d, %d, %d), \n", __func__,
            read_gridSize[0], read_gridSize[1], read_gridSize[2]);
    {#{% if ilh.isMultiDim() %}
        {% for m_dim in ilh.getMultidimList() %}
    printf("[KERNEL_DEBUG]|%s| read_gridSize_d{{m_dim}}: (%d, %d, %d), \n", __func__,
            read_gridSize_d{{m_dim}}[0], read_gridSize_d{{m_dim}}[1], read_gridSize_d{{m_dim}}[2]);
        {% endfor %}
    {% endif %}#}
#endif 

    {% if ilh.isMultiDim() %}
        {% for m_dim in ilh.getMultidimList() %}
    constexpr unsigned int num_of_pkts_per_bytes_d{{m_dim}} = mem_data_width / {{config["data_width"] * config["vector_factor"] * m_dim}};
        {% endfor %}
    {% endif %}
    {% if isTiling %}
    ops::hls::MemConfigTile config;
        {# TODO: {% if ilh.isMultiDim() %}
            {% for m_dim in ilh.getMultidimList() %}
    ops::hls::MemConfigTile config_d{{m_dim}};
            {% endfor %} 
        {% endif %} #}

    ops::hls::genMemConfigTileV2<mem_data_width, data_width>(read_gridSize, range, tile_size, tile_count, overlap_size, effective_tile_size, last_tile_size, total_xblocks, config);   
    {% else %}
    ops::hls::MemConfig config;
        {% if ilh.isMultiDim() %}
            {% for m_dim in ilh.getMultidimList() %}
    ops::hls::MemConfig config_d{{m_dim}};
            {% endfor %}
        {% endif %}
    ops::hls::genMemConfig<mem_data_width, axis_data_width, data_width>(read_gridSize, range, config, batch_size);
        {% if ilh.isMultiDim() %}
            {% for m_dim in ilh.getMultidimList() %}
    ops::hls::multidimConfigConverter<{{m_dim}}>(config, config_d{{m_dim}});
            {% endfor %}
        {% endif %}
    {% endif %}
    {% if not isTiling %}
    const unsigned int num_beats = config.total_xblocks;
    const unsigned int num_pkts = num_of_pkts_per_beat * num_beats;
    {% endif %}
    {#{% if ilh.isMultiDim() %}
        {% for m_dim in ilh.getMultidimList() %}
    const unsigned int num_pkts_d{{m_dim}} = num_of_pkts_per_bytes_d{{m_dim}} * config_d{{m_dim}}.total_xblocks;
        {% endfor %}
    {% endif %}#}
    {% if not isTiling%}
#ifdef DEBUG_LOG
    printf("[KERNEL_DEBUG]|%s| REALIZED numbers: num_beats: %d, num_pkts: %d,\n", __func__,
         num_beats, num_pkts);

    printf("[KERNEL_DEBUG]|%s| batch_size: %d \n", __func__, batch_size);
#endif 
    {% endif %}
    {% if config["datamover_mode"] == 3 %}
    if (is_loopback)
    {
    {% endif %}
    {% if config["datamover_mode"] == 3 or config["datamover_mode"] == 1 %}
        datamover_outerloop_{{ilh.id}}_dataflow_region_read(
                num_pkts,
        {#{% if ilh.isMultiDim() %}
            {% for m_dim in ilh.getMultidimList() %}
                num_pkts_d{{m_dim}},
            {% endfor %}
        {% endif %}#}
                config
        {%- if ilh.isMultiDim() -%}
            {%- for m_dim in ilh.getMultidimList() -%}
                ,{{"\n"}}                config_d{{m_dim}}
            {%- endfor -%}
        {%- endif -%}
        {%- for arg in ilh.joint_args|ops_dat -%}
            {%- if arg is ops_read or arg is ops_rw -%}
                ,{{"\n"}}                arg{{arg.id}} 
            {%- endif -%}
        {%- endfor -%}
        {%- for arg in ilh.joint_args|ops_dat -%}
            {%- if arg is ops_read -%}
                ,{{"\n"}}                {{axis_name(arg)}}
            {%- elif arg is ops_rw -%}
                ,{{"\n"}}                {{axis_name_t2(arg, "out")}}
            {%- endif -%}
        {%- endfor -%}
        );

        datamover_outerloop_{{ilh.id}}_loopback(loopback_itr, num_pkts
        {#{%- if ilh.isMultiDim() -%}
            {%- for m_dim in ilh.getMultidimList() -%}
                ,{{"\n"}}                num_pkts_d{{m_dim}}
            {%- endfor -%}
        {%- endif -%}#}
        {%- for arg in ilh.joint_args|ops_dat -%}
            {%- if (arg is not ops_rw) and arg is is_arg_swap(ilh) -%}
                ,{{"\n"}}                {{axis_name(arg)}}
            {%- else -%}
                ,{{"\n"}}                {{axis_name_t2(arg, "out")}}, {{axis_name_t2(arg, "in")}}
            {%- endif -%}
        {%- endfor -%}
        );

        datamover_outerloop_{{ilh.id}}_dataflow_region_write(
                num_pkts,
        {#{% if ilh.isMultiDim() %}
            {% for m_dim in ilh.getMultidimList() %}
                num_pkts_d{{m_dim}},
            {% endfor %}
        {% endif %}#}
                config
        {%- if ilh.isMultiDim() -%}
            {%- for m_dim in ilh.getMultidimList() -%}
                ,{{"\n"}}                config_d{{m_dim}}
            {%- endfor -%}
        {%- endif -%}
        {%- for arg in ilh.joint_args|ops_dat -%}
            {%- if arg is ops_write or arg is ops_rw -%}
                ,{{"\n"}}                arg{{arg.id}} 
            {%- endif -%}
        {%- endfor -%}
        {%- for arg in ilh.joint_args|ops_dat -%}
            {%- if arg is ops_write -%}
                ,{{"\n"}}                {{axis_name(arg)}}
            {%- elif arg is  ops_rw -%}
                ,{{"\n"}}                {{axis_name_t2(arg, "in")}}
            {%- endif -%}
        {%- endfor -%}
        );
    {% endif %}
    {% if config["datamover_mode"] == 3 %}
    }
    else
    {
    {% endif %}
    {% if config["datamover_mode"] == 3 or config["datamover_mode"] == 2 %}
        datamover_outerloop_{{ilh.id}}_dataflow_read_write(
                outer_itr,
        {% if not isTiling %}
                num_pkts,
            {#% if ilh.isMultiDim() %}
                {% for m_dim in ilh.getMultidimList() %}
                num_pkts_d{{m_dim}},
                {% endfor %}
            {% endif %#}
        {% endif %}
                config,
        {% if ilh.isMultiDim() %}
                {% for m_dim in ilh.getMultidimList() %}
                config_d{{m_dim}},
                {% endfor %}
        {% endif %}
        {% for arg in ilh.joint_args|ops_dat %}
            {% if isTiling and config["tile_banks"] > 1 and config["datamover_lib"] == 1 %}
                {% for i in range(config["tile_banks"]) %}
                arg{{(arg.id)}}_b{{i}},
                {% endfor %}
            {% else %}
                arg{{(arg.id)}},
            {% endif %}
        {% endfor %}
        {{axis_argument_set()}}
            );
    {% endif %}
    {% if config["datamover_mode"] == 3 %}
    }
    {% endif %}
}


{% endblock %}
{% block datamover_prototype_end %}
{% endblock %}