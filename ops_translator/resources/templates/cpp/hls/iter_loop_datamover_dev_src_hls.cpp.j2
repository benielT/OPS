static void datamover_outerloop_{{ilh.id}}_dataflow_read_write_dataflow_region(
    {#% if not isTiling %}
        {% if ilh.isMultiDim() %}
            {% for m_dim in ilh.getMultidimList() %}
        const unsigned int num_pkts_d{{m_dim}},
            {% endfor %}
        {% endif %}
    {% endif %#}
    {% if isTiling %}
        {% if prog.is_interleave() %}
        const unsigned int num_small_trans,
        const unsigned int num_big_trans,
        const unsigned short bank_tile_size_x_floor,
        const unsigned short bank_tile_size_x_ceil,
        const ap_uint<8> big_bank_tile_size_x_mask,
        const unsigned short tile_offset_x_floor,
        const ap_uint<3> big_tile_offset_x_banks_upper,
        const unsigned short tile_offset_y,
        const unsigned short tile_size_y,
        const unsigned int total_rows, 
        const unsigned short bank_avoid_x_floor,
        const ap_uint<8> big_bank_avoid_x_mask,
        const unsigned short avoid_y,
        const unsigned short bank_grid_size_x_floor,
        const ap_uint<3> big_grid_size_x_banks_upper,
        const unsigned short grid_size_y,
        const unsigned short tile_size_z,
        {#const unsigned int num_big_trans, 
        const unsigned int num_small_trans,
        const unsigned short bank_tile_size_x_floor,
        const unsigned short bank_tile_size_x_ceil,
        const ap_uint<{{config["tile_banks"]}}> big_bank_tile_size_x_mask,
        const unsigned short bank_grid_size_x_floor,
        const ap_uint<{{log2(config["tile_banks"])|int}}> big_grid_size_x_banks_upper,
        const unsigned short grid_size_y,
        const unsigned short tile_offset_x_floor, 
        const ap_uint<{{log2(config["tile_banks"])|int}}> big_tile_offset_x_banks_upper, //starting bank
        const unsigned short tile_offset_y,
        const unsigned short tile_size_y,
            {% if ndim == 3 %}
        const unsigned short tile_size_z,
            {% endif %}
        const unsigned int total_rows,
        const unsigned short bank_avoid_x_floor,
        const ap_uint<{{config["tile_banks"]}}> big_bank_avoid_x_mask,
            {% if ndim == 3 %}
        const unsigned short avoid_y,
            {% endif %}
        //const unsigned int stride_y,
            {% if ndim == 3 %}
        //const unsigned int stride_z,
            {% endif %}
        //const bool is_small_tile,
        //const unsigned int small_tile_pkts,
        {% endif %}
        {% if ndim == 3 %}
        //const ap_uint<192>& command,
        //const ap_uint<160>& short_command,
        {% else %}
        //const ap_uint<144>& command,
        //const ap_uint<128>& short_command,
        {% endif %}
        {% if config["tile_banks"] > 1 %}
            {% if ndim == 3 %}
        //unsigned int abs_row_offset,
            {% endif %}
        //unsigned int z_row_stride,#}
        {% endif %}
    {% else %}
        const unsigned int num_pkts,
        const ops::hls::MemConfig& memconfig,
        {% if ilh.isMultiDim() %}
            {% for m_dim in ilh.getMultidimList() %}
        const ops::hls::MemConfig& memconfig_d{{m_dim}},
            {% endfor %}
        {% endif %}
    {% endif %}
    {% for arg in ilh.joint_args|ops_dat %}
        {% if config["datamover_lib"] == 1 %}
            {% if isTiling and config["tile_banks"] > 1 %}
                {% for i in range(config["tile_banks"]) %}
        ap_uint<mem_data_width>* arg{{(arg.id)}}_b{{i}},
                {% endfor %}
            {% else %}
        ap_uint<mem_data_width>* arg{{(arg.id)}},
            {% endif %}
        {% else %}
        ::hls::burst_maxi<ap_uint<mem_data_width>>& arg{{(arg.id)}},
        {% endif %}
    {% endfor %}
        {{axis_parameter_set()}})    
{
    #pragma HLS DATAFLOW
    {% for arg in ilh.joint_args|ops_dat %}
        {% if arg is ops_read_or_rw%}
            {% if prog.is_interleave() %}
    ::hls::stream<ap_uint<32>> arg{{arg.id}}_read_offset_strm[{{config["tile_banks"]}}];
    #pragma HLS STREAM variable = arg{{arg.id}}_read_offset_strm depth = 32
    ::hls::stream<ap_uint<mem_data_width>> arg{{arg.id}}_read_mem_redirect_strm[{{config["tile_banks"]}}];
    #pragma HLS STREAM variable = arg{{arg.id}}_read_mem_redirect_strm depth = {{(config["maxi_read_burst_length"]  * config["num_read_outstanding"])|int + 6}}   
