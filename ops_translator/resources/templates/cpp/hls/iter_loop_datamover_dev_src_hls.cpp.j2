        ops::hls::stream2streamStepdown<mem_data_width, {{axis_data_width(arg)-}}>(arg{{arg.id}}_read_mem_strm, arg{{arg.id}}_read_reduced_mem_strm, {%if isTiling %}num_beats{% else %}{{num_beats(arg)}}{% endif %});
        {% endif %}
    {% endfor %}
    {% for arg in ilh.joint_args|ops_dat|ops_read_or_rw %}
        {% if config["vector_factor"] * ilh.dats[arg.dat_id][0].dim < config["mem_vector_factor"] %}
            {% if arg is ops_read %}
        ops::hls::stream2axis<{{axis_data_width(arg)-}}>(arg{{arg.id}}_read_reduced_mem_strm, {{axis_name(arg)}}, {%if isTiling %}num_pkts{% else %}{{num_pkts(arg)}}{% endif %});
            {% elif arg is ops_rw %}
        ops::hls::stream2axis<{{axis_data_width(arg)-}}>(arg{{arg.id}}_read_reduced_mem_strm, {{axis_name_t2(arg, "out")}}, {%if isTiling %}num_pkts{% else %}{{num_pkts(arg)}}{% endif %});
            {% endif %}
        {% else %}
            {% if arg is ops_read %}
        ops::hls::stream2axis<{{axis_data_width(arg)-}}>(arg{{arg.id}}_read_mem_strm, {{axis_name(arg)}}, {%if isTiling %}num_pkts{% else %}{{num_pkts(arg)}}{% endif %});
            {% elif arg is ops_rw %}
        ops::hls::stream2axis<{{axis_data_width(arg)-}}>(arg{{arg.id}}_read_mem_strm, {{axis_name_t2(arg, "out")}}, {%if isTiling %}num_pkts{% else %}{{num_pkts(arg)}}{% endif %});
            {% endif %}
        {% endif %}
