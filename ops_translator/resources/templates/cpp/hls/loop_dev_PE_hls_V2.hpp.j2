static constexpr unsigned short adj_shift_bits = {{log2(config["vector_factor"] * config["tile_banks"])|int}};
static constexpr unsigned short sub_tile_pe_count = {{(config["tile_banks"]/2)|int}};
static constexpr unsigned short sub_shift_bits = {{(log2(config["tile_banks"]) - 1)|int}};
