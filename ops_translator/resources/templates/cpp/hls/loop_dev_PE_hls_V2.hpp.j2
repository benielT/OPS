{% block kernel_core %}
/*
{% for arg in lh.args %}
    {{arg}}
{% endfor %}
*/
inline void kernel_{{lh.kernel}}_core(
    {% for arg in lh.args %}
        {% if loop.last %}
            {% if consts %}
                {% set last_check = False %}
            {% else %}
                {% set last_check = True %}
            {% endif %}
        {% else %}
            {% set last_check = False %}
        {% endif %}
        {% if arg is ops_read %}
            {% if prog.findStencil(arg.stencil_ptr) %}
                {% for i in range(prog.findStencil(arg.stencil_ptr).num_points)%}
                    {% if lh.dats[arg.dat_id].isMultiDim() %}
                        {% for m_dim in range(lh.dats[arg.dat_id].dim) %}
        const stencil_type& reg_{{arg.id}}_{{i}}_{{m_dim}}{{"," if (not loop.last or not last_check)}}
                        {% endfor %}
                    {% else %}
        const stencil_type& reg_{{arg.id}}_{{i}}{{"," if (not loop.last or not last_check)}}
                    {% endif %}
                {% endfor %}
            {% endif %}
        {% endif %}
        {% if arg is ops_write or arg is ops_rw%}
            {% if prog.findStencil(arg.stencil_ptr) %}
                {% for i in range(prog.findStencil(arg.stencil_ptr).num_points)%}
                    {% if lh.dats[arg.dat_id].isMultiDim() %}
                        {% for m_dim in range(lh.dats[arg.dat_id].dim) %}
        stencil_type& reg_{{arg.id}}_{{i}}_{{m_dim}}{{"," if (not loop.last or not last_check)}}
                        {% endfor %}
                    {% else %}
        stencil_type& reg_{{arg.id}}_{{i}}{{"," if (not loop.last or not last_check)}}
                    {% endif %}
                {% endfor %}
            {% else %}
        // ERROR: couldn't find stencil 
            {% endif %}
        {% endif %}
        {% if arg is ops_idx %}
        const short idx[3]{{"," if (not loop.last or not last_check)}}
        {% endif %}
        {% if arg is ops_gbl %}
        const {{arg.typ}}* {{kernel_args[loop.index0]}}{{"," if not loop.last}}
        {% endif %}
    {% endfor %}
    {% for const in consts %}
        const {{const.typ}}& {{const.ptr}}{{"," if not loop.last}}
    {% endfor %}
)
{
#ifdef DEBUG_LOG
    printf("[KERNEL_INTERNAL_CORE]|%s| starting kernel core: kernel_{{lh.kernel}}_core\n",__func__);
#endif
    {{kernel_body}}

#ifdef DEBUG_LOG
    {% for arg in lh.args %}
        {% if arg is ops_read %}
            {% if prog.findStencil(arg.stencil_ptr) %}
                {% for i in range(prog.findStencil(arg.stencil_ptr).num_points)%}
                    {% if lh.dats[arg.dat_id].isMultiDim() %}
                        {% for m_dim in range(lh.dats[arg.dat_id].dim) %}
    printf("[KERNEL_INTERNAL_CORE]|%s| read_val - reg_{{arg.id}}_{{i}}_{{m_dim}}: %f \n", __func__, reg_{{arg.id}}_{{i}}_{{m_dim}});
                        {% endfor %}
                    {% else %}
    printf("[KERNEL_INTERNAL_CORE]|%s| read_val - reg_{{arg.id}}_{{i}}: %f \n", __func__, reg_{{arg.id}}_{{i}});
                    {% endif %}
                {% endfor %}
            {% endif %}
        {% elif arg is ops_write or arg is ops_rw%}
            {% if prog.findStencil(arg.stencil_ptr) %}
                {% for i in range(prog.findStencil(arg.stencil_ptr).num_points)%}
                    {% if lh.dats[arg.dat_id].isMultiDim() %}
                        {% for m_dim in range(lh.dats[arg.dat_id].dim) %}
    printf("[KERNEL_INTERNAL_CORE]|%s| write_val - reg_{{arg.id}}_{{i}}_{{m_dim}}: %f \n", __func__, reg_{{arg.id}}_{{i}}_{{m_dim}});
                        {% endfor %}
                    {% else %}
    printf("[KERNEL_INTERNAL_CORE]|%s| write_val - reg_{{arg.id}}_{{i}}: %f \n", __func__, reg_{{arg.id}}_{{i}});
                    {% endif %}
                {% endfor %}
            {% endif %}
        {% elif arg is ops_idx %}
    printf("[KERNEL_INTERNAL_CORE]|%s| index_val: (%d, %d, %d) \n", __func__, idx[0], idx[1], idx[2]);
        {% endif %}
    {% endfor %}
#endif

#ifdef DEBUG_LOG
    printf("[KERNEL_INTERNAL_CORE]|%s| exiting: kernel_{{lh.kernel}}_core\n",__func__);
#endif
}
{% endblock %}

{% block stencil_class %}
{% if prog.is_interleave() %}
template <unsigned short NUM_SUB_TILE, unsigned short SUB_TILE_ID>
{% endif %}
class Stencil_{{lh.kernel}} : public ops::hls::StencilCoreV2<stencil_type, read_num_points_{{lh.kernel}}, {{"vector_factor" if (not prog.is_interleave()) else "subtile_vector_factor"}}, ops::hls::CoefTypes::CONST_COEF,
        read_stencil_size_{{lh.kernel}}, read_stencil_dim_{{lh.kernel}}{{", true" if tiles}}>
{
    using ops::hls::StencilCoreV2<stencil_type, read_num_points_{{lh.kernel}}, {{"vector_factor" if (not prog.is_interleave()) else "subtile_vector_factor"}}, ops::hls::CoefTypes::CONST_COEF,
            read_stencil_size_{{lh.kernel}}, read_stencil_dim_{{lh.kernel}}{{", true" if tiles}}>::m_stencilConfig;
public:

    void stencilRun(
    {% for arg in lh.args|ops_not_idx %}
        {% if loop.last %}
            {% if consts %}
                {% set last_check = False %}
            {% else %}
                {% set last_check = True %}
            {% endif %}
        {% else %}
            {% set last_check = False %}
        {% endif %}
        {% if arg is ops_dat %}
            {% if (arg is ops_read) %}
                {% if prog.is_interleave() %}
            half_{{"in_" if target == "tapa"}}{{widen_stream_dt_name(arg)}}& {{hls_stream_name_t2(arg, "l_rd")-}},
            half_{{"in_" if target == "tapa"}}{{widen_stream_dt_name(arg)}}& {{hls_stream_name_t2(arg, "u_rd")-}}{{"," if (not loop.last or not last_check)}}
                {% else %}
            {{"in_" if target == "tapa"}}{{widen_stream_dt_name(arg)}}& {{hls_stream_name(arg)-}}{{"," if (not loop.last or not last_check)}}
                {% endif %}
            {% elif arg is ops_write %}
                {% if prog.is_interleave() %}
            half_{{"out_" if target == "tapa"}}{{widen_stream_dt_name(arg)}}& {{hls_stream_name_t2(arg, "l_wr")-}},
            half_{{"out_" if target == "tapa"}}{{widen_stream_dt_name(arg)}}& {{hls_stream_name_t2(arg, "u_wr")-}}{{"," if (not loop.last or not last_check)}}
                {% else %}
            {{"out_" if target == "tapa"}}{{widen_stream_dt_name(arg)}}& {{hls_stream_name(arg)-}}{{"," if (not loop.last or not last_check)}}
                {% endif %}
            {% else %}
                {% if prog.is_interleave() %}
            half_{{"in_" if target == "tapa"}}{{widen_stream_dt_name(arg)}}& {{hls_stream_name_t2(arg, "l_rd")-}},
            half_{{"in_" if target == "tapa"}}{{widen_stream_dt_name(arg)}}& {{hls_stream_name_t2(arg, "u_rd")-}},
            half_{{"out_" if target == "tapa"}}{{widen_stream_dt_name(arg)}}& {{hls_stream_name_t2(arg, "l_wr")-}},
            half_{{"out_" if target == "tapa"}}{{widen_stream_dt_name(arg)}}& {{hls_stream_name_t2(arg, "u_wr")-}}{{"," if (not loop.last or not last_check)}}
                {% else %}
            {{"in_" if target == "tapa"}}{{widen_stream_dt_name(arg)}}& {{hls_stream_name_t2(arg, "rd")-}},
            {{"out_" if target == "tapa"}}{{widen_stream_dt_name(arg)}}& {{hls_stream_name_t2(arg, "wr")-}}{{"," if (not loop.last or not last_check)}}
                {% endif %}
            {% endif %}
        {% elif arg is ops_gbl %}
            const {{arg.typ}}& {{get_arg_gbl_name(arg)}}{{"," if (not loop.last or not last_check)}}
        {% endif %}
    {% endfor %}
    {% for const in consts %}
            const {{const.typ}}& {{const.ptr}}{{"," if not loop.last}}
    {% endfor %}
        )
    {
        {% if isTiling %}
        ::ops::hls::StencilConfigCoreSingleTile stencilConfig = m_stencilConfig;
        #pragma HLS ARRAY_PARTITION variable = stencilConfig.tile_size dim = 1 complete
        //#pragma HLS ARRAY_PARTITION variable = stencilConfig.is_tiled dim = 1 complete
        #pragma HLS ARRAY_PARTITION variable = stencilConfig.is_first dim = 1 complete
        #pragma HLS ARRAY_PARTITION variable = stencilConfig.is_last dim = 1 complete
        //#pragma HLS ARRAY_PARTITION variable = stencilConfig.last_tile_size dim = 1 complete
        //#pragma HLS ARRAY_PARTITION variable = stencilConfig.tile_count dim = 1 complete
        //#pragma HLS ARRAY_PARTITION variable = stencilConfig.grid_size dim = 1 complete
        {% else %}
        ::ops::hls::StencilConfigCore stencilConfig = m_stencilConfig;
        #pragma HLS ARRAY_PARTITION variable = stencilConfig.lower_limit dim = 1 complete
        #pragma HLS ARRAY_PARTITION variable = stencilConfig.upper_limit dim = 1 complete
        #pragma HLS ARRAY_PARTITION variable = stencilConfig.grid_size dim = 1 complete
        {% endif %}
        const unsigned short peId = m_PEId;

        const unsigned short span_x = {{span_x}};
        const unsigned short half_span_x = {{half_span_x}};
        {% if isTiling %}
            {% if prog.is_interleave() %}
        // --------- Interleave Subtile related computations ------------
        constexpr bool is_first_sub_tile = (SUB_TILE_ID == 0);
        constexpr bool is_last_sub_tile = (SUB_TILE_ID == (NUM_SUB_TILE - 1));
        constexpr unsigned short sub_tile_id_mul_subtile_vector_factor = SUB_TILE_ID * subtile_vector_factor;
        //---------------------------------------------------------------
            {% endif %}
        const unsigned short true_tile_size_x = stencilConfig.tile_size[0] << {{"adj_" if prog.is_interleave()}}shift_bits;
        // overlap_size = {{get_overlap_tile_size(config["SLR_count"], config["iter_par_factor"], half_span_x, config["mem_vector_factor"])|int}}, total_PEs = {{get_total_PEs(config["SLR_count"], config["iter_par_factor"])}} 
        // const unsigned short overlap_offset_x = {{(get_overlap_tile_size(config["SLR_count"], config["iter_par_factor"], half_span_x, config["mem_vector_factor"]) - (half_span_x * get_total_PEs(config["SLR_count"], config["iter_par_factor"])) - 1)|int}};
        const bool is_first_x = stencilConfig.is_first[0] {% if prog.is_interleave()-%} && is_first_sub_tile {%-endif-%};
        const bool is_last_x = stencilConfig.is_last[0] {% if prog.is_interleave()-%} && is_last_sub_tile {%-endif-%};

            {% if prog.is_interleave() %}
        // --------- Interleave Subtile related computations ------------
        const short x_idx_adjust = is_first_x ? -half_span_x : sub_tile_id_mul_subtile_vector_factor - half_span_x;
#ifdef DEBUG_LOG
        printf("[DEBUG][INTERNAL][%s:%d{%- if prog.is_interleave() -%}:%d{%- endif -%}] Interleave Related Parameters\n" \
                "is_first_sub_tile: %d, is_last_sub_tile: %d, sub_tile_id_mul_subtile_vector_factor: %d, x_idx_adjust: %d, \n"
                , __func__, m_PEId, SUB_TILE_ID, is_first_sub_tile, is_last_sub_tile, sub_tile_id_mul_subtile_vector_factor, x_idx_adjust);
#endif
        //---------------------------------------------------------------
            {% endif %}

        // const unsigned short adj_half_span_x = stencilConfig.tile_count[0] == 1? half_span_x : half_span_x * (peId + 1);
        const unsigned short adj_half_span_x_lower = is_first_x? half_span_x : half_span_x * (peId + 1);
        const unsigned short adj_half_span_x_upper = is_last_x? half_span_x : half_span_x * (peId + 1);
            {% if lh.ndim == 3 %}
        //const unsigned short adj_half_span_y = stencilConfig.tile_count[1] == 1? half_span_x : half_span_x * (peId + 1);
        const unsigned short adj_half_span_y_lower = stencilConfig.is_first[1]? half_span_x : half_span_x * (peId + 1);
        const unsigned short adj_half_span_y_upper = stencilConfig.is_last[1]? half_span_x : half_span_x * (peId + 1);
            {% endif %}
        {% endif %}

        {% if isTiling %}
        // static limits are set outside the tile loops
        const unsigned short lower_limit_x = adj_half_span_x_lower;
        //const unsigned short min_limit_x_const = stencilConfig.last_tile_upper_limit_x < true_tile_size_x ? stencilConfig.last_tile_upper_limit_x : true_tile_size_x;  //(stencilConfig.last_tile_upper_limit_x - adj_half_span_x) < adj_half_span_x ? adj_half_span_x : (stencilConfig.last_tile_upper_limit_x - adj_half_span_x);
        //const unsigned short upper_limit_x = (min_limit_x_const - adj_half_span_x_upper) < adj_half_span_x_upper ? adj_half_span_x_upper : min_limit_x_const - adj_half_span_x_upper;
        const unsigned short upper_limit_x = stencilConfig.is_last[0] ? stencilConfig.last_tile_upper_limit_x - 1 : true_tile_size_x - adj_half_span_x_upper;
            {% if lh.ndim == 3 %}
        const unsigned short lower_limit_y = adj_half_span_y_lower;
        const unsigned short lower_limit_z = half_span_x;
        const unsigned short upper_limit_z = stencilConfig.outer_loop_limit - span_x;
        const unsigned short upper_limit_y = (stencilConfig.tile_size[1] - adj_half_span_y_upper) < adj_half_span_y_upper ? adj_half_span_y_upper : (stencilConfig.tile_size[1] - adj_half_span_y_upper);
            {% else %}
        const unsigned short lower_limit_y = half_span_x;
        const unsigned short upper_limit_y = stencilConfig.outer_loop_limit - span_x;
            {% endif %}
        {% else %}
        const unsigned short lower_limit_x = stencilConfig.lower_limit[0];
        const unsigned short lower_limit_y = stencilConfig.lower_limit[1];
        const unsigned short lower_limit_z = stencilConfig.lower_limit[2];
        const unsigned short upper_limit_x = stencilConfig.upper_limit[0];
        const unsigned short upper_limit_y = stencilConfig.upper_limit[1];
        const unsigned short upper_limit_z = stencilConfig.upper_limit[2];
        {% endif %}

        {#% if isTiling %}
        const unsigned short total_tiles = stencilConfig.tile_count[0] * stencilConfig.tile_count[1];
        unsigned short tile_x = 0;
        unsigned short tile_y = 0;
        for (unsigned short tile_id = 0; tile_id < total_tiles; tile_id++)
        {

            const unsigned short tile_id_reged = register_it(tile_id);
            const unsigned short prev_tile_x = tile_x;
            tile_x = tile_id_reged % stencilConfig.tile_count[0];
            
            if (prev_tile_x >= tile_x)
            {
                tile_y++;
            }

        {% else %#}
        {% if not isTiling %}
        for (unsigned bat = 0; bat < stencilConfig.batch_size; bat++)
        {
        {% endif %}
        {% set read_origin_wide_diff = read_stencil.read_origin_diff %}
        {% set read_origin_wide_diff_x = read_origin_wide_diff.x %}
        {% set read_origin_wide_diff_x  = ((read_origin_wide_diff_x + config["vector_factor"] - 1) / config["vector_factor"])|round(0,"floor")|int %}
            //read_origin_wide_diff_x: {{read_origin_wide_diff_x}}, read_origin_wide_diff: {{read_origin_wide_diff}}
        {#% if isTiling %}
            //const bool is_last_tile_x = (tile_x == stencilConfig.tile_count[0] - 1);
            const unsigned short tile_size_x = is_last_tile_x ? stencilConfig.last_tile_size[0] : stencilConfig.tile_size[0];
            const unsigned short true_tile_size_x = tile_size_x << shift_bits;
            {% if lh.ndim == 3 %}
            const bool is_last_tile_y = (tile_y == stencilConfig.tile_count[1] - 1);
            const unsigned short tile_size_y = is_last_tile_y ? stencilConfig.last_tile_size[1] : stencilConfig.tile_size[1];
            {% endif %}
        {% endif %#}
        //  *** counters definitions ****
        {% if lh.ndim == 1 %}
            short i = {{(-read_origin_wide_diff_x) - 1}};
        {% elif lh.ndim == 2 %}
            short i = {{ (-read_origin_wide_diff_x) - 1}};
            short j = -{{read_origin_wide_diff.y}}; 
        {% elif lh.ndim == 3 %}
            short i = {{ (-read_origin_wide_diff_x) - 1}};
            short j = {{(-read_origin_wide_diff.y)}}; 
            short k = {{(-read_origin_wide_diff.z)}};
            {% if not isTiling %}
            unsigned short plane_diff = stencilConfig.grid_size[0] * stencilConfig.grid_size[1] - 1;
            {% else %}
            //unsigned short plane_diff = tile_size_x * tile_size_y - 1;
            unsigned short plane_diff = stencilConfig.tile_size[0] * stencilConfig.tile_size[1] - 1;
            {% endif %}
        {% endif %}

        //  *** stencil description and read & write point definitions  ****
            /*
            {{widen_read_stencil_desc}}
            */
        {#% for stencil_name in lh.get_unique_read_stencil_names() %}
            // Stencil: {{stencil_name}}
            {% for point  in prog.findStencil(stencil_name).points %}
            //      {{"|-" if not loop.last else "`-"}} point: {{point}}
            {% endfor %}
            {% for buffer in widen_stencil_disc_map[stencil_name].window_buffers %}
            // read point: {{buffer.read_point}}, write point: {{buffer.write_point}}
