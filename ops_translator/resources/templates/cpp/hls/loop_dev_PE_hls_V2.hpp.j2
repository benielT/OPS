static constexpr unsigned short subtile_full_vector_factor = subtile_vector_factor + {{(lh.read_stencil.stencil_size.x - 1)}};
static constexpr unsigned short subtile_full_vector_factor_min_hs = subtile_vector_factor + {{((lh.read_stencil.stencil_size.x - 1)/2)|int}};
{% endif %}
{% for arg in lh.args | ops_dat%}
static constexpr unsigned short {{vector_factor_name(arg)}} = (vector_factor {% if prog.is_interleave() %} * 2 + {{(lh.read_stencil.stencil_size.x - 1)}}{% endif %}) * {{lh.dats[arg.dat_id].dim}};
static constexpr unsigned short {{axis_data_width_name(arg)}} = ({{vector_factor_name(arg)}} * data_width);
    {% if prog.is_interleave() %}
