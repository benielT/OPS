{% extends "cpp/hls/iter_loop_dev_inc_hls.hpp.j2" %}

{% macro internal_stream_name(arg) -%}
{%- if arg is ops_read -%}
arg{{arg.id}}_arg{{ilh.getSwapArg(arg).id}}_streams
{%- else -%}
arg{{ilh.getSwapArg(arg).id}}_arg{{arg.id}}_streams
{%- endif -%}
{%- endmacro -%}
{% if slr_iter_par_fact is defined %}
{% set iter_par_factor_internal = config["iter_par_factor"][slr_iter_par_fact]%}
{% else %}
{% set iter_par_factor_internal = config["iter_par_factor"]%}
{% endif %}
{% macro iter_par_factor() -%}
{%- if slr_iter_par_fact is defined -%}
iter_par_factor_{{slr_iter_par_fact}}
{%- else -%}
iter_par_factor
{%- endif -%}
{%- endmacro -%}
{% macro joint_PE_body_p1() %}
    {% for stream_interconnector, dat_id in ilh.interconnectors %}
    ::hls::stream<ap_uint<{{lmac.axis_data_width_datid(dat_id)}}>> {{stream_interconnector}}[{{iter_par_factor()}}]{% if prog.is_interleave() %}[{{config["tile_banks"]}}]{% endif %};
    #pragma HLS STREAM variable = {{stream_interconnector}}   {#depth = {{config["hls_interconnect_buff_size"]}}#}
    
    #pragma HLS ARRAY_PARTITION variable = {{stream_interconnector}}
    {% endfor %}
    {% for df_node in ilh.get_active_df_graph().getAllLoopNodes() %}
        {% set loop_idx = df_node.node_uid %}
        {% set lh = df_node.loop %}
        {% if prog.is_interleave() %}
            {% for arg in lh.args| ops_dat | ops_read_or_rw %}
                {% set global_arg = ilh.getArg(arg.dat_id) %}
                {% if global_arg is not ops_read_or_rw %}
                    {% set global_arg = ilh.getSwapArg(global_arg) %}
                {% endif %}
    ::hls::stream<ap_uint<half_axis_data_width_{{lh.kernel}}_{{global_arg.id}}>> arg{{global_arg.id}}_{{lh.kernel}}_in_subtile_stream[{{iter_par_factor()}}][{{config["tile_banks"]}}];
    #pragma HLS STREAM variable = arg{{global_arg.id}}_{{lh.kernel}}_in_subtile_stream {#depth = {{config["hls_interconnect_buff_size"]}}#}
    
    #pragma HLS ARRAY_PARTITION variable = arg{{global_arg.id}}_{{lh.kernel}}_in_subtile_stream

    ::hls::stream<ap_uint<half_axis_data_width_{{lh.kernel}}_{{ilh.getSwapArg(global_arg).id}}>> arg{{ilh.getSwapArg(global_arg).id}}_{{lh.kernel}}_out_subtile_stream[{{iter_par_factor()}}][{{config["tile_banks"]}}];
    #pragma HLS STREAM variable = arg{{ilh.getSwapArg(global_arg).id}}_{{lh.kernel}}_out_subtile_stream {#depth = {{config["hls_interconnect_buff_size"]}}#}
    
    #pragma HLS ARRAY_PARTITION variable = arg{{ilh.getSwapArg(global_arg).id}}_{{lh.kernel}}_out_subtile_stream
            {% endfor %}
        {% endif %}
    {% endfor %}
{% endmacro %}
{% macro joint_PE_body_p2(i='i', PEID_offset=none, is_temporal_first = none, is_temporal_last = none) %}
    {% set prev_arg_str = {} %}
    {% for df_node in ilh.get_active_df_graph().getAllLoopNodes() %}
        {% set loop_idx = df_node.node_uid %}
        {% set lh = df_node.loop %}
            {#% if PEID_offset is none %}
    //const unsigned short PEId_offset_i = PEId_offset + {{i}};
            {% set PEID_offset = "PEId_offset" %}
            {% else %}
    //const unsigned short PEId_offset_i = {% if i is number%}{{PEID_offset + i}}{% else %}{{PEID_offset}} + {{i}}{% endif %};
            {% endif %#}
        {% if prog.is_interleave() %}
            {% for arg in lh.args| ops_dat | ops_read_or_rw %}
                {% set global_arg = ilh.getArg(arg.dat_id) %}
                {% if global_arg is not ops_read_or_rw %}
                    {% set global_arg = ilh.getSwapArg(global_arg) %}
                {% endif %}
                {% if is_temporal_first == none or is_temporal_first == true %}
    ops::hls::stream2interleave<{{lmac.axis_data_width(arg)}}, {{config["data_width"]}}, {{config["tile_banks"]}}, {{((lh.read_stencil.stencil_size.x - 1)/2)|int}}>({{ilh.PE_args[loop_idx][arg.id][0]}}[0], arg{{global_arg.id}}_{{lh.kernel}}_in_subtile_stream[{{i}}], num_pkts);
                {% else %}
    ops::hls::updateInterleaveBoundaries<{{lmac.axis_data_width(arg)}}, {{config["data_width"]}}, {{config["tile_banks"]}}, {{((lh.read_stencil.stencil_size.x - 1)/2)|int}}>(arg{{ilh.getSwapArg(global_arg).id}}_{{lh.kernel}}_out_subtile_stream[{{i-1}}], arg{{global_arg.id}}_{{lh.kernel}}_in_subtile_stream[{{i}}], num_pkts);
                {% endif %}
            {% endfor %}
            {% for subtile in range((config["tile_banks"]/2)|int) %}
    kernel_{{lh.kernel}}_PE<{{(config["tile_banks"]/2)|int}}, {{subtile}}>(
                {{PEID_offset}}, {{i}}, 
                stencilConfig,
                {% for arg in lh.args| ops_dat | ops_read_or_rw %}
                    {% set global_arg = ilh.getArg(arg.dat_id) %}
                    {% if global_arg is not ops_read_or_rw %}
                        {% set global_arg = ilh.getSwapArg(global_arg) %}
                    {% endif %}
                    {% if loop.last %}
                        {% if consts_map[loop_idx] or lh.args|ops_gbl %}
                            {% set last_check = False %}
                        {% else %}
                            {% set last_check = True %}
                        {% endif %}
                    {% else %}
                        {% set last_check = False %}
                    {% endif %}
                arg{{global_arg.id}}_{{lh.kernel}}_in_subtile_stream[{{i}}][{{subtile*2}}],
                arg{{global_arg.id}}_{{lh.kernel}}_in_subtile_stream[{{i}}][{{subtile*2 + 1}}],
                arg{{ilh.getSwapArg(global_arg).id}}_{{lh.kernel}}_out_subtile_stream[{{i}}][{{subtile*2}}],
                arg{{ilh.getSwapArg(global_arg).id}}_{{lh.kernel}}_out_subtile_stream[{{i}}][{{subtile*2 + 1}}]{{"," if not last_check}}
                {% endfor %}
                {% for const_arg in lh.args|ops_gbl %}
                {{get_arg_gbl_name(const_arg)}}{{"," if (not loop.last or consts_map[loop_idx])}}
                {% endfor %}
                {% for const in consts_map[loop_idx] %}
                {{const.ptr}}{{"," if not loop.last}}
                {% endfor %}  
            );
            {% endfor %}
            {% for arg in lh.args| ops_dat | ops_read_or_rw %}
                    {% set global_arg = ilh.getArg(arg.dat_id) %}
                    {% if global_arg is not ops_read_or_rw %}
                        {% set global_arg = ilh.getSwapArg(global_arg) %}
                    {% endif %}
                {% if is_temporal_last == none or is_temporal_last == true %}
    ops::hls::interleave2stream<{{lmac.axis_data_width(ilh.getSwapArg(global_arg))}}, {{config["data_width"]}}, {{config["tile_banks"]}}, {{((lh.read_stencil.stencil_size.x - 1)/2)|int}}>(arg{{ilh.getSwapArg(global_arg).id}}_{{lh.kernel}}_out_subtile_stream[{{i}}], {{ilh.PE_args[loop_idx][arg.id][0]}}[1], num_pkts);
                {% endif %}
            {% endfor %}
        {% else %}
    kernel_{{lh.kernel}}_PE(
            {{PEID_offset}}, {{i}},
            stencilConfig,
            {% for (arg_str, direction) in ilh.PE_args[loop_idx]%}
                {% if loop.last %}
                    {% if consts_map[loop_idx] or lh.args|ops_gbl %}
                        {% set last_check = False %}
                    {% else %}
                        {% set last_check = True %}
                    {% endif %}
                {% else %}
                    {% set last_check = False %}
                {% endif %}
            {{arg_str}}{% if direction == 0 %}[{{i}}]{% elif direction == 1 %}[{{i}}+1]{% endif %}{{"," if not last_check}}
                {%if "arg" in arg_str %}
                    {% set _ = prev_arg_str.update({arg_str : 1}) %}
                {% endif %}
            {% endfor %}
            {% for const_arg in lh.args|ops_gbl %}
            {{get_arg_gbl_name(const_arg)}}{{"," if (not loop.last or consts_map[loop_idx])}}
            {% endfor %}
            {% for const in consts_map[loop_idx] %}
            {{const.ptr}}{{"," if not loop.last}}
            {% endfor %}
    );
        {% endif %}
    {% endfor %}
{% endmacro %}
{% block header_block %}
#include <ops_hls_kernel_support.h>
    {% if slr_iter_par_fact is defined %}
#include <kernel_outerloop_{{ilh.id}}_{{slr_iter_par_fact}}.hpp>
    {% else %}
#include <kernel_outerloop_{{ilh.id}}.hpp>
    {% endif %} 
{% endblock %}

{#% block joint_PE %}
static void joint_PE_outerloop_{{ilh.id}}(const unsigned short PEId, const ops::hls::{{"StencilConfigCoreSingleTile" if isTiling else "StencilConfigCore"}} stencilConfig, 
    {% if prog.is_interleave() %}
        const unsigned int num_pkts,
    {% endif %}
    {% for arg in ilh.joint_args|ops_not_idx %}
        {% if arg is ops_dat %}
            {% if arg is not ops_rw %}
        ::hls::stream<ap_uint<{{lmac.axis_data_width(arg)}}>>{%if not prog.is_interleave()%}&{%endif%} {{hls_name(arg)-}}{%if prog.is_interleave()%}[{{config["tile_banks"]}}]{%endif%}{{", " if not loop.last or consts }}
            {% else %}
        ::hls::stream<ap_uint<{{lmac.axis_data_width(arg)}}>>{%if not prog.is_interleave()%}&{%endif%} {{hls_name_t2(arg, "in")-}}{%if prog.is_interleave()%}[{{config["tile_banks"]}}]{%endif%}, 
        ::hls::stream<ap_uint<{{lmac.axis_data_width(arg)}}>>{%if not prog.is_interleave()%}&{%endif%} {{hls_name_t2(arg, "out")-}}{%if prog.is_interleave()%}[{{config["tile_banks"]}}]{%endif%}{{", " if not loop.last or consts }}
            {% endif %}
        {% elif arg is ops_gbl %}
        const {{arg.typ}}& {{get_arg_gbl_name(arg)}}{{", " if not loop.last or consts }}
        {% endif %}
    {% endfor %}
    {% for const in consts %}
        const {{const.typ}}& {{const.ptr}}{{", " if not loop.last }}
    {% endfor %})
{
    {% if ilh.get_active_df_graph().getAllLoopNodes()|length > 1 or prog.is_interleave() %}
#pragma HLS INLINE
    {% endif %}
    {% for stream_interconnector, dat_id in ilh.interconnectors %}
    ::hls::stream<ap_uint<{{lmac.axis_data_width_datid(dat_id)}}>> {{stream_interconnector}}{% if prog.is_interleave() %}[{{config["tile_banks"]}}]{% endif %};
    #pragma HLS STREAM variable = {{stream_interconnector}} depth = 10
    {% endfor %}

    {% for df_node in ilh.get_active_df_graph().getAllLoopNodes() %}
        {% set loop_idx = df_node.node_uid %}
        {% set lh = df_node.loop %}
        {% if prog.is_interleave() %}
            {% for arg_str in ilh.PE_args[loop_idx]%}
    ::hls::stream<ap_uint<half_axis_data_width_{{lh.kernel}}_{{loop.index0}}>> arg{{loop.index0}}_{{lh.kernel}}_subtile_stream[{{config["tile_banks"]}}];
    #pragma HLS STREAM variable = arg{{loop.index0}}_{{lh.kernel}}_subtile_stream depth = 10
            {% endfor %}
            {% for arg in lh.args| ops_dat | ops_read_or_rw %}
    ops::hls::stream2interleave<{{lmac.axis_data_width(arg)}}, {{config["data_width"]}}, {{config["tile_banks"]}}, {{((lh.read_stencil.stencil_size.x - 1)/2)|int}}>({{ilh.PE_args[loop_idx][arg.id]}}, arg{{arg.id}}_{{lh.kernel}}_subtile_stream, num_pkts);
            {% endfor %}
            {% for subtile in range((config["tile_banks"]/2)|int) %}
    kernel_{{lh.kernel}}_PE<{{(config["tile_banks"]/2)|int}}, {{subtile}}>(PEId, stencilConfig,
                {% for arg_str in ilh.PE_args[loop_idx]%}
                    {% if loop.last %}
                        {% if consts_map[loop_idx] or lh.args|ops_gbl %}
                            {% set last_check = False %}
                        {% else %}
                            {% set last_check = True %}
                        {% endif %}
                    {% else %}
                        {% set last_check = False %}
                    {% endif %}
                arg{{loop.index0}}_{{lh.kernel}}_subtile_stream[{{subtile*2}}],
                arg{{loop.index0}}_{{lh.kernel}}_subtile_stream[{{subtile*2 + 1}}]{{"," if not last_check}}
                {% endfor %}
                {% for const_arg in lh.args|ops_gbl %}
                {{get_arg_gbl_name(const_arg)}}{{"," if (not loop.last or consts_map[loop_idx])}}
                {% endfor %}
                {% for const in consts_map[loop_idx] %}
                {{const.ptr}}{{"," if not loop.last}}
                {% endfor %}  
            );
            {% endfor %}
            {% for arg in lh.args| ops_dat | ops_write_or_rw %}
    ops::hls::interleave2stream<{{lmac.axis_data_width(arg)}}, {{config["data_width"]}}, {{config["tile_banks"]}}, {{((lh.read_stencil.stencil_size.x - 1)/2)|int}}>(arg{{arg.id}}_{{lh.kernel}}_subtile_stream, {{ilh.PE_args[loop_idx][arg.id]}}, num_pkts);
            {% endfor %}
        {% else %}
    kernel_{{lh.kernel}}_PE(PEId, stencilConfig,
            {% for arg_str in ilh.PE_args[loop_idx]%}
                {% if loop.last %}
                    {% if consts_map[loop_idx] or lh.args|ops_gbl %}
                        {% set last_check = False %}
                    {% else %}
                        {% set last_check = True %}
                    {% endif %}
                {% else %}
                    {% set last_check = False %}
                {% endif %}
            {{arg_str}}{{"," if not last_check}}
            {% endfor %}
            {% for const_arg in lh.args|ops_gbl %}
            {{get_arg_gbl_name(const_arg)}}{{"," if (not loop.last or consts_map[loop_idx])}}
            {% endfor %}
            {% for const in consts_map[loop_idx] %}
            {{const.ptr}}{{"," if not loop.last}}
            {% endfor %}
    );
        {% endif %}
    {% endfor %}
}

{% endblock %#}

