                {% endfor %}
                {% for tile in range(config["tile_banks"]) %}
        hls::stream <ap_axiu<{{lmac.axis_data_width(arg)}}, 0, 0, 0>>& {{lmac.axis_name_t3(arg, tile, "out")-}}{{", " if (not (loop.last and first_loop_last) or consts or ilh.joint_args|ops_gbl)}}
