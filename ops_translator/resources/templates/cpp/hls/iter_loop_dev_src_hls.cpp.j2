{#template <unsigned short AXIS_DATA_WIDTH>
static void kernel_outerloop_{{ilh.id}}_axis_2_stream(::hls::stream<ap_axiu<AXIS_DATA_WIDTH, 0, 0, 0>>& in_strm, ::hls::stream<ap_uint<AXIS_DATA_WIDTH>>& out_strm,
        const unsigned int num_pkts, const unsigned int outer_itr) {
    for (unsigned int itr = 0; itr < outer_itr; itr++)
        ops::hls::axis2stream<AXIS_DATA_WIDTH>(in_strm, out_strm, num_pkts);
}

template <unsigned short AXIS_DATA_WIDTH>
static void kernel_outerloop_{{ilh.id}}_stream_2_axis(::hls::stream<ap_uint<AXIS_DATA_WIDTH>>& in_strm, ::hls::stream<ap_axiu<AXIS_DATA_WIDTH, 0, 0, 0>>& out_strm,
        const unsigned int num_pkts, const unsigned int outer_itr) {
    for (unsigned int itr = 0; itr < outer_itr; itr++)
        ops::hls::stream2axis<AXIS_DATA_WIDTH>(in_strm, out_strm, num_pkts);
}#}

