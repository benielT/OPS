        {% if arg is ops_write %}
            {% if prog.is_interleave() %}
                {% for tile in range(config["tile_banks"]) %}
        ops::hls::stream2axis<{{lmac.axis_data_width(arg)}}>({{internal_stream_name(arg)}}[1][{{tile}}], {{lmac.axis_name_t3(arg,tile)-}},  num_pkts);
                {% endfor %}
            {% else %}
        ops::hls::stream2axis<{{lmac.axis_data_width(arg)}}>({{internal_stream_name(arg)}}[{{iter_par_factor()}}], {{lmac.axis_name(arg)-}},  num_pkts);
            {% endif %}
        {% elif arg is ops_rw %}
            {% if prog.is_interleave() %}
                {% for tile in range(config["tile_banks"]) %}
        ops::hls::stream2axis<{{lmac.axis_data_width(arg)}}>({{internal_stream_name(arg)}}[1][{{tile}}], {{lmac.axis_name_t3(arg,tile< "out")-}},  num_pkts);
                {% endfor %}
            {% else %}
        ops::hls::stream2axis<{{lmac.axis_data_width(arg)}}>({{internal_stream_name(arg)}}[{{iter_par_factor()}}], {{lmac.axis_name_t2(arg, "out")-}}, num_pkts);
            {% endif %}
        {% endif %}
    {% endfor %}

}
{% endblock %}

{% block kernel_main_loop_region %}
static void kernel_outerloop_{{ilh.id}}_main_region(const unsigned short slr_region, const unsigned int outer_itr, const ops::hls::{{"StencilConfigCoreTiled" if isTiling else "StencilConfigCore"}}& stencilConfig, 
    {% if not isTiling -%}
        const unsigned int num_pkts,
        {#% if ilh.isMultiDim() -%}
            {%- for m_dim in ilh.getMultidimList() -%}
        const unsigned int num_pkts_d{{m_dim}}, 
            {%- endfor -%}
        {%- endif -%#}
    {%- endif %}
    {% for arg in ilh.joint_args|ops_dat %}
        {% set first_loop_last = loop.last %}
        {% if arg is not ops_rw %}
            {% if prog.is_interleave() %}
                {% for tile in range(config["tile_banks"]) %}
        hls::stream <ap_axiu<{{lmac.axis_data_width(arg)}}, 0, 0, 0>>& {{lmac.axis_name_t3(arg,tile)-}}{{", " if (not (loop.last and first_loop_last) or consts or ilh.joint_args|ops_gbl)}}
                {% endfor %}
            {% else %}
        hls::stream <ap_axiu<{{lmac.axis_data_width(arg)}}, 0, 0, 0>>& {{lmac.axis_name(arg)-}}{{", " if (not loop.last or consts or ilh.joint_args|ops_gbl)}}
            {% endif %}
        {% else %}
            {% if prog.is_interleave() %}
                {% for tile in range(config["tile_banks"]) %}
       hls::stream <ap_axiu<{{lmac.axis_data_width(arg)}}, 0, 0, 0>>& {{lmac.axis_name_t3(arg, tile, "in")-}},
                {% endfor %}
                {% for tile in range(config["tile_banks"]) %}
       hls::stream <ap_axiu<{{lmac.axis_data_width(arg)}}, 0, 0, 0>>& {{lmac.axis_name_t3(arg, tile, "out")-}}{{", " if (not (loop.last and first_loop_last) or consts or ilh.joint_args|ops_gbl)}}
                {% endfor %}
            {% else %}
        hls::stream <ap_axiu<{{lmac.axis_data_width(arg)}}, 0, 0, 0>>& {{lmac.axis_name_t2(arg, "in")-}},
        hls::stream <ap_axiu<{{lmac.axis_data_width(arg)}}, 0, 0, 0>>& {{lmac.axis_name_t2(arg, "out")-}}{{", " if (not loop.last or consts or ilh.joint_args|ops_gbl)}}
            {% endif %}
        {% endif %}
    {% endfor %}
    {% for const_arg in ilh.joint_args|ops_gbl%}
        const {{const_arg.typ}}& {{get_arg_gbl_name(const_arg)}}{{", " if not loop.last or consts}}
    {% endfor %}
    {% for const in consts %}
        const {{const.typ}}& {{const.ptr}}{{", " if not loop.last }}
    {% endfor %}
    )
{
    {%if isTiling %}
    const unsigned short total_tiles = stencilConfig.tile_count[0] * stencilConfig.tile_count[1];
    unsigned short tile_x = 0;
        {% if ndim == 3 %}
    unsigned short tile_y = 0;
	const unsigned short z_diff = stencilConfig.outer_loop_limit - 1;
        {% else %}
    const unsigned short y_diff = stencilConfig.outer_loop_limit - 1;
        {% endif %}
    {% endif %}

    for (unsigned int i = 0; i < outer_itr; i++)
    {
    {% if isTiling %}
        for (unsigned short tile_id = 0; tile_id < total_tiles; tile_id++)
        {
    //#pragma HLS PIPELINE
            if (tile_id > 0) {
                tile_x++;
                if (tile_x >= stencilConfig.tile_count[0]) {
                    tile_x = 0;
        {% if ndim == 3 %}
                    tile_y++;
        {% endif %}
                }
            } 

            const unsigned short tile_size_x = tile_x == (stencilConfig.tile_count[0] -1) ? stencilConfig.last_tile_size[0] : stencilConfig.tile_size[0];
        {% if ndim == 3 %}
            const unsigned short tile_size_y = tile_y == (stencilConfig.tile_count[1] -1) ? stencilConfig.last_tile_size[1] : stencilConfig.tile_size[1];
            {% if prog.is_interleave() %}
            bool small_tile = tile_size_x <= {{(config["tile_banks"]/2)|int}};
            const unsigned int tile_size_y_mul_z_diff = tile_size_y * z_diff;
            {% if config["vector_factor"] < config["mem_vector_factor"] %}
            const unsigned int mem_tile_size_x = tile_size_x >> {{log2(config["mem_vector_factor"]/config["vector_factor"])|int}};
            const unsigned int widen_tile_size_x = ((mem_tile_size_x + {{(config["tile_banks"]) - 1}}) >> {{log2(config["tile_banks"])|int}}) << {{log2(config["mem_vector_factor"]/config["vector_factor"])|int}};
            {% else %}
            const unsigned int widen_tile_size_x = (tile_size_x + {{(config["tile_banks"]) - 1}}) >> {{log2(config["tile_banks"])|int}};
            {% endif %}
            {#const unsigned int adj_widen_tile_size_x = small_tile ? widen_tile_size_x << 1 : widen_tile_size_x;#}
            const unsigned int num_pkts_div_by_banks = widen_tile_size_x * tile_size_y_mul_z_diff;
            {% else %}
            const unsigned int num_pkts = tile_size_x * tile_size_y * z_diff;
            {% endif %}
        {% else %}
            {% if prog.is_interleave() %}
            bool small_tile = tile_size_x =< {{(config["tile_banks"]/2)|int}}; 
            {% if config["vector_factor"] < config["mem_vector_factor"] %}
            const unsigned int mem_tile_size_x = tile_size_x >> {{log2(config["mem_vector_factor"]/config["vector_factor"])|int}};
            const unsigned int widen_tile_size_x = ((mem_tile_size_x + {{(config["tile_banks"]) - 1}}) >> {{log2(config["tile_banks"])|int}}) << {{log2(config["mem_vector_factor"]/config["vector_factor"])|int}};
            {% else %}
            const unsigned int widen_tile_size_x = (tile_size_x + {{(config["tile_banks"]) - 1}}) >> {{log2(config["tile_banks"])|int}};
            {% endif %}
            {#const unsigned int adj_widen_tile_size_x = small_tile ? widen_tile_size_x << 1 : widen_tile_size_x;#}
            const unsigned int num_pkts_div_by_banks = widen_tile_size_x * y_diff;
            {% else %}
            const unsigned int num_pkts = tile_size_x * y_diff;
            {% endif %}
        {% endif %}
        {#% if ilh.isMultiDim() %}
            {% for m_dim in ilh.getMultidimList() %}
            const unsigned int num_pkts_d{{m_dim}} = num_pkts * {{m_dim}};
            {% endfor %}
        {% endif %#}

        #ifdef DEBUG_LOG
            printf("[KERNEL_DEBUG]|%s| \n===============================\n", __func__);
            printf("[KERNEL_DEBUG]|%s| tile_size_x: %d\n", __func__, tile_size_x);
        {% if ndim == 3 %}
            printf("[KERNEL_DEBUG]|%s| tile_size_y: %d\n", __func__, tile_size_y);
        {% endif %}
        {% if prog.is_interleave() %}
            printf("[KERNEL_DEBUG]|%s| widen_tile_size_x: %d\n", __func__, widen_tile_size_x);
            printf("[KERNEL_DEBUG]|%s| num_pkts_div_bank: %d\n", __func__, num_pkts_div_by_banks);
        {% endif %}
            printf("[KERNEL_DEBUG]|%s| ===============================\n", __func__);
        #endif
            //const ops::hls::StencilConfigCoreSingleTile tileConfig = ops::hls::stencilConfigCoreSingleTileGen{%if ndim == 3 %}3D{%else%}2D{%endif%}(stencilConfig, tile_x//{%if ndim == 3 %}, tile_y{%endif%});
            ops::hls::StencilConfigCoreSingleTile tileConfig;
            tileConfig.dim = stencilConfig.dim;
            const bool is_last_tile_x = (tile_x == stencilConfig.tile_count[0] - 1);
            {% if ndim == 3 %}
            const bool is_last_tile_y = (tile_y == stencilConfig.tile_count[1] - 1);
            {% endif %}
            tileConfig.tile_size[0] = {%if prog.is_interleave() %}widen_tile_size_x{% else %}tile_size_x{% endif %};
            {% if ndim == 3 %}
            tileConfig.tile_size[1] = tile_size_y;
            {% else %}
            tileConfig.tile_size[1] = stencilConfig.grid_size[1];
            {% endif %}
            tileConfig.tile_size[2] = stencilConfig.grid_size[2];
            tileConfig.outer_loop_limit = stencilConfig.outer_loop_limit;
            //tileConfig.is_tiled[0] = stencilConfig.tile_count[0] > 1;
            //tileConfig.is_tiled[1] = stencilConfig.tile_count[1] > 1;
            tileConfig.is_first[0] = tile_x == 0;
            {% if ndim == 3 %}
            tileConfig.is_first[1] = tile_y == 0;
            {% else %}
            tileConfig.is_first[1] = true;
            {% endif %}
            tileConfig.is_last[0] = is_last_tile_x;
            {% if ndim == 3 %}
            tileConfig.is_last[1] = is_last_tile_y;
            {% else %}
            tileConfig.is_last[1] = true;
            {% endif %}
            tileConfig.last_tile_upper_limit_x = stencilConfig.last_tile_upper_limit_x;
            tileConfig.line_diff = widen_tile_size_x - 1;
            {% if ndim == 3 %}
            tileConfig.plane_diff = widen_tile_size_x * tile_size_y - 1;
            {% else %}
            tileConfig.plane_diff = 0;
            {% endif %}
    
    #ifdef DEBUG_LOG
            printf("[KERNEL_DEBUG]|%s| \n=== StencilConfigCoreSingleTile ======\n", __func__);
            printf("[KERNEL_DEBUG]|%s| tile_size: (%d, %d, %d)\n", __func__, tileConfig.tile_size[0], tileConfig.tile_size[1], tileConfig.tile_size[2]);
            printf("[KERNEL_DEBUG]|%s| dim: %d\n", __func__, tileConfig.dim);
            printf("[KERNEL_DEBUG]|%s| outer_loop_limit: %d\n", __func__, tileConfig.outer_loop_limit); 
            printf("[KERNEL_DEBUG]|%s| last_tile_upper_limit_x: %d\n", __func__, tileConfig.last_tile_upper_limit_x); 
            printf("[KERNEL_DEBUG]|%s| is_first: (%d,%d) \n", __func__, tileConfig.is_first[0], tileConfig.is_first[1]); 
            printf("[KERNEL_DEBUG]|%s| is_last: (%d,%d) \n", __func__, tileConfig.is_last[0], tileConfig.is_last[1]);
            printf("[KERNEL_DEBUG]|%s| ===============================\n", __func__);
    #endif 
    {% endif %}

            kernel_outerloop_{{ilh.id}}_dataflow_region(slr_region, {% if isTiling %}tileConfig{% else %}stencilConfig{% endif %}, 
                {% if prog.is_interleave() %}
                num_pkts_div_by_banks,
                {% else %}
                num_pkts,
                {% endif %} 
                {#%if ilh.isMultiDim() -%}{% for m_dim in ilh.getMultidimList() -%}num_pkts_d{{m_dim}}, {% endfor -%} {% endif -%#}
                {% for arg in ilh.joint_args|ops_dat -%}
                {% set first_loop_last = loop.last %}
                    {% if arg is not ops_rw %}
                        {% if prog.is_interleave() %}
                            {% for tile in range(config["tile_banks"]) %}
                {{lmac.axis_name_t3(arg,tile)-}}{{", " if not (loop.last and first_loop_last) or consts or ilh.joint_args|ops_gbl }}
                            {% endfor %}
                        {% else %}
                {{lmac.axis_name(arg)-}}{{", " if not loop.last or consts or ilh.joint_args|ops_gbl }}
                        {% endif %}
                    {% else %}
                        {% if prog.is_interleave() %}
                            {% for tile in range(config["tile_banks"]) %}
                {{lmac.axis_name_t3(arg,tile,"in")-}},
                            {% endfor %}
                            {% for tile in range(config["tile_banks"]) %}
                {{lmac.axis_name_t3(arg,tile,"out")-}}{{", " if not (loop.last and first_loop_last) or consts or ilh.joint_args|ops_gbl -}}
                            {% endfor %}
                        {% else %}
                {{lmac.axis_name_t2(arg, "in")-}}, 
                {{lmac.axis_name_t2(arg, "out")-}}{{", " if not loop.last or consts or ilh.joint_args|ops_gbl-}}
                        {% endif %}
                    {% endif %}
                {% endfor %}
                {% for const_arg in ilh.joint_args|ops_gbl %}{{get_arg_gbl_name(const_arg)}}{{", " if not loop.last or consts-}}{% endfor %}
                {% for const in consts %}{{const.ptr}}{{", " if not loop.last-}}{% endfor %});
    {% if isTiling %}
        }
        tile_x = 0;
        {% if ndim == 3 %}
        tile_y = 0;
        {% endif %}
    {% endif %}
    }
}
{% endblock %}

{% block kernel_top_prototype %}
{{super()}}
{% endblock %}
{% block kernel_top_body %}
{
    #pragma HLS INTERFACE s_axilite port = slr_region bundle = control
    #pragma HLS INTERFACE s_axilite port = outer_itr bundle = control

    {% for i in range(ndim)%}
    #pragma HLS INTERFACE s_axilite port = stencilConfig_grid_size_{{i}} bundle = control

    {% endfor %}
    {#{% for i in range(ndim)%}
    #pragma HLS INTERFACE s_axilite port = gridProp_actual_size_{{i}} bundle = control
    {% endfor %}
    {% for i in range(ndim)%}
    #pragma HLS INTERFACE s_axilite port = gridProp_grid_size_{{i}} bundle = control
    {% endfor %}#}
    #pragma HLS INTERFACE s_axilite port = stencilConfig_dim bundle = control
    #pragma HLS INTERFACE s_axilite port = stencilConfig_total_itr bundle = control

#ifndef OPS_TILING
    {% for i in range(ndim)%}
    #pragma HLS INTERFACE s_axilite port = stencilConfig_lower_limit_{{i}} bundle = control

    {% endfor %}
    {% for i in range(ndim)%}
    #pragma HLS INTERFACE s_axilite port = stencilConfig_upper_limit_{{i}} bundle = control

    {% endfor %}
#endif
    #pragma HLS INTERFACE s_axilite port = stencilConfig_outer_loop_limit bundle = control
#ifndef OPS_TILING
    #pragma HLS INTERFACE s_axilite port = stencilConfig_batch_size bundle = control
#else

    {% if ndim == 3 %}
    #pragma HLS INTERFACE s_axilite port = tile_size_x bundle = control
    #pragma HLS INTERFACE s_axilite port = tile_size_y bundle = control
    #pragma HLS INTERFACE s_axilite port = last_tile_size_x bundle = control
    #pragma HLS INTERFACE s_axilite port = last_tile_size_y bundle = control
    #pragma HLS INTERFACE s_axilite port = tile_count_x bundle = control
    #pragma HLS INTERFACE s_axilite port = tile_count_y bundle = control
    #pragma HLS INTERFACE s_axilite port = total_xblocks bundle = control
    #pragma HLS INTERFACE s_axilite port = last_tile_upper_limit_x bundle = control

    {% else %}
    #pragma HLS INTERFACE s_axilite port = tile_size_x bundle = control
    #pragma HLS INTERFACE s_axilite port = last_tile_size_x bundle = control
    #pragma HLS INTERFACE s_axilite port = tile_count_x bundle = control
    #pragma HLS INTERFACE s_axilite port = total_xblocks bundle = control
    #pragma HLS INTERFACE s_axilite port = last_tile_upper_limit_x bundle = control

    {% endif %}
#endif
    {% for const_arg in ilh.joint_args|ops_gbl%}
    #pragma HLS INTERFACE s_axilite port = {{get_arg_gbl_name(const_arg)}} bundle = control

    {% endfor %}    
    {% for const in consts %}
    #pragma HLS INTERFACE s_axilite port = {{const.ptr}} bundle = control

    {% endfor %}

    {% for arg in ilh.joint_args|ops_dat %}
        {% if arg is not ops_rw %}
            {% if prog.is_interleave() %}
                {% for tile in range(config["tile_banks"]) %}
    #pragma HLS INTERFACE axis port = {{lmac.axis_name_t3(arg, tile)}} register {#register_mode=both#}

                {% endfor %}
            {% else %}
    #pragma HLS INTERFACE axis port = {{lmac.axis_name(arg)}} register {#register_mode=both#}

            {% endif %}
        {% else %}
            {% if prog.is_interleave() %}
                {% for tile in range["tile_banks"] %}
    #pragma HLS INTERFACE axis port = {{lmac.axis_name_t3(arg, tile, "in")}} register {#register_mode=both#}
                {% endfor %}
                {% for tile in range["tile_banks"] %}
    #pragma HLS INTERFACE axis port = {{lmac.axis_name_t3(arg, tile, "out")}} register {#register_mode=both#}
                {% endfor %}
            {% else %}
    #pragma HLS INTERFACE axis port = {{lmac.axis_name_t2(arg, "in")}} register {#register_mode=both#}
    #pragma HLS INTERFACE axis port = {{lmac.axis_name_t2(arg, "out")}} register {#register_mode=both#}
            {% endif %}
        {% endif %}
    {% endfor %}

    #pragma HLS INTERFACE ap_ctrl_chain port = return
    #pragma HLS INTERFACE s_axilite port = return bundle = control   

    {% if not isTiling %}
    ops::hls::StencilConfigCore stencilConfig;
    {% else %}
    ops::hls::StencilConfigCoreTiled stencilConfig;
    {% endif %}

    stencilConfig.dim = stencilConfig_dim;
    {% for i in range(ndim)%}
    stencilConfig.grid_size[{{i}}] = stencilConfig_grid_size_{{i}};
    {% endfor %}
    {% if not isTiling %}
        {% for i in range(ndim)%}
    stencilConfig.lower_limit[{{i}}] = stencilConfig_lower_limit_{{i}};
        {% endfor %}
        {% for i in range(ndim)%}
    stencilConfig.upper_limit[{{i}}] = stencilConfig_upper_limit_{{i}};
        {% endfor %}
    stencilConfig.total_itr = stencilConfig_total_itr;
    {% endif %}
    stencilConfig.outer_loop_limit = stencilConfig_outer_loop_limit;
    {% if not isTiling %}
    stencilConfig.batch_size = stencilConfig_batch_size;
    stencilConfig.line_diff = stencilConfig_grid_size_0 - 1;
        {% if ndim == 3 %}
    stencilConfig.plane_diff = stencilConfig_grid_size_0 * stencilConfig_grid_size_1 - 1;
        {% else %}
    stencilConfig.plane_diff = 0;
        {% endif %}
    {% else %}
    stencilConfig.tiling_dim = {{2 if ndim == 3 else 1}};
    stencilConfig.tile_size[0] = tile_size_x;
    stencilConfig.tile_size[1] = {% if ndim == 3 %}tile_size_y{% else %}1{% endif %};
    stencilConfig.last_tile_size[0] = last_tile_size_x;
    stencilConfig.last_tile_size[1] = {% if ndim == 3 %}last_tile_size_y{% else %}1{% endif %};
    stencilConfig.tile_count[0] = tile_count_x;
    stencilConfig.tile_count[1] = {% if ndim == 3 %}tile_count_y{% else %}1{% endif %};
    stencilConfig.last_tile_upper_limit_x = last_tile_upper_limit_x;
    {% endif %}
    {% if not isTiling %}
    //constexpr unsigned short num_of_pkts_per_beat = mem_data_width / axis_data_width;
    // unsigned int tmp1 = stencilConfig_batch_size; //this cause 2 DSP! 
    // unsigned int tmp2 = stencilConfig_total_itr;
    // unsigned int num_pkts = tmp1 * tmp2;
    unsigned int num_pkts = stencilConfig_batch_size * stencilConfig_total_itr;
        {#% if ilh.isMultiDim() %}
            {% for m_dim in ilh.getMultidimList() %}
    unsigned int num_pkts_d{{m_dim}} = num_pkts * {{m_dim}};
            {% endfor %}
        {% endif %#}
    {% else %}
    //constexpr unsigned short num_of_pkts_per_beat = mem_data_width / axis_data_width;
    //constexpr unsigned short bytes_per_pkt = sizeof(stencil_type) * vector_factor;
    const unsigned int num_beats = total_xblocks;
    const unsigned int num_pkts = num_beats * num_of_pkts_per_beat;
    //const unsigned int total_bytes = num_pkts * bytes_per_pkt;
    {% endif %}

#ifdef DEBUG_LOG
    {% if not isTiling %}
    unsigned int num_beats = num_pkts / num_of_pkts_per_beat;
    {% endif %}
    printf("[KERNEL_DEBUG]|%s| num_beats: %d, num_pkts: %d\n", __func__,
         num_beats, num_pkts);
    {#% if ilh.isMultiDim() %}
        {% for m_dim in ilh.getMultidimList() %}
    printf("[KERNEL_DEBUG]|%s| num_pkts_d{{m_dim}}: %d\n", __func__, num_pkts_d{{m_dim}});
        {% endfor %}
    {% endif %#}
    {% if not isTiling %}
    printf("[KERNEL_DEBUG]|%s| stencilConfig: dim: %hu, grid_size:(%d,%d,%d), lower_limit:(%d,%d,%d), upper_limit:(%d,%d,%d), \
            total_itr: %d, outer_loop_limit: %d, batch_size: %d\n", __func__,
        stencilConfig.dim,
        stencilConfig.grid_size[0], stencilConfig.grid_size[1], stencilConfig.grid_size[2],
        stencilConfig.lower_limit[0], stencilConfig.lower_limit[1], stencilConfig.lower_limit[2],
        stencilConfig.upper_limit[0], stencilConfig.upper_limit[1], stencilConfig.upper_limit[2],
        stencilConfig.total_itr,
        stencilConfig.outer_loop_limit,
        stencilConfig.batch_size);
    {% else %}

    printf("[KERNEL_DEBUG]|%s| stencilConfig: dim: %hu, grid_size:(%d,%d,%d), outer_loop_limit: %d, tiling_dim: %hu, tile_size:(%d,%d),\
        last_tile_size:(%d,%d), tile_count:(%d,%d)\n, total_xblocks: %d\n", __func__,
        stencilConfig.dim,
        stencilConfig.grid_size[0], stencilConfig.grid_size[1], stencilConfig.grid_size[2],
        stencilConfig.outer_loop_limit,
        stencilConfig.tiling_dim,
        stencilConfig.tile_size[0], stencilConfig.tile_size[1],
        stencilConfig.last_tile_size[0], stencilConfig.last_tile_size[1],
        stencilConfig.tile_count[0], stencilConfig.tile_count[1], total_xblocks);
    {% endif %}
#endif

#ifdef DEBUG_LOG
    printf("[KERNEL_DEBUG]|%s| Starting outerloop_{{ilh.id}} kernel TOP \n", __func__);
#endif

    kernel_outerloop_{{ilh.id}}_main_region(slr_region, outer_itr, stencilConfig, 
            {%if not isTiling%}num_pkts, 
                {#%if ilh.isMultiDim() -%}{% for m_dim in ilh.getMultidimList() -%}num_pkts_d{{m_dim}}, {% endfor -%} {% endif -%#}
            {%endif%}
            {% for arg in ilh.joint_args|ops_dat -%}
                {% set first_loop_last = loop.last %}
                {% if arg is not ops_rw %}
                    {% if prog.is_interleave() %}
                        {% for tile in range(config["tile_banks"]) %}
                {{lmac.axis_name_t3(arg,tile)-}}{{", " if not (loop.last and first_loop_last) or consts or ilh.joint_args|ops_gbl }}
                        {% endfor %}
                    {% else %}
                {{lmac.axis_name(arg)-}}{{", " if not loop.last or consts or ilh.joint_args|ops_gbl }}
                    {% endif %}
                {% else %}
                    {% if prog.is_interleave() %}
                        {% for tile in range(config["tile_banks"]) %}
                {{lmac.axis_name_t3(arg,tile,"in")-}},
                        {% endfor %}
                        {% for tile in range(config["tile_banks"]) %}
                {{lmac.axis_name_t3(arg,tile,"out")-}}{{", " if not (loop.last and first_loop_last) or consts or ilh.joint_args|ops_gbl }}
                        {% endfor %}
                    {% else %}
                {{lmac.axis_name_t2(arg, "in")-}}, 
                {{lmac.axis_name_t2(arg, "out")-}}{{", " if not loop.last or consts or ilh.joint_args|ops_gbl}}
                    {% endif %}
                {% endif %}
            {% endfor %}
            {% for const_arg in ilh.joint_args|ops_gbl %}{{get_arg_gbl_name(const_arg)}}{{", " if not loop.last or consts }}{% endfor %}
            {% for const in consts %}{{const.ptr}}{{", " if not loop.last }}{% endfor %});

#ifdef DEBUG_LOG
    printf("[KERNEL_DEBUG]|%s| Ending outerloop_{{ilh.id}} kernel TOP \n", __func__);
#endif
}
