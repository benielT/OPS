template <typename T>
void generate_grid(TestGrid<T>& grid, const TestParameters& test_params, bool init_zero=false)
{
    std::cout << "Allocating Grid " << std::endl;

    size_t total_grid_size = test_params.grid_size_x * test_params.grid_size_y * test_params.grid_size_y;
    std::cout << "Adjusted grid sizes: (" << test_params.grid_size_x << ", " << test_params.grid_size_y << ", " << test_params.grid_size_z << "), total_grid_size: " << total_grid_size << std::endl;
    grid.grid_size_x = test_params.grid_size_x;
    grid.grid_size_y = test_params.grid_size_y;
    grid.grid_size_z = test_params.grid_size_z;
    
    grid.buffer.resize(total_grid_size);

    std::cout << "Succesfully buffer resized" << std::endl;

    if (IS_TEST_VALUES) {
        for (size_t i = 0; i < total_grid_size; i++) {
            if (not init_zero) {
                grid.buffer[i] = i;
            } else {
                grid.buffer[i] = 0;
            }
        }
    } else {
        unsigned int seed = TEST_SEED < 0 ? test_params.test_seed : TEST_SEED;
        std::mt19937 mtrand(seed);
        std::normal_distribution<T> value_dist(1,1000);
        
        for (size_t i = 0; i < total_grid_size; i++) {
            if (not init_zero) {
                grid.buffer[i] = value_dist(mtrand);
            } else {
                grid.buffer[i] = 0;
            }
        }
    }

//ifdef DEBUG_LOG
//    print_grid(grid);
//#endif

    // alt_buffer allocate
    size_t total_vect_elements = grid.grid_size_x / MEM_VECTOR_FACTOR * grid.grid_size_y * grid.grid_size_z;

    for (int bank = 0; bank < TILE_BANKS; bank++) {
        size_t banks_vect_elements = (total_vect_elements / TILE_BANKS) + (bank < (total_vect_elements % TILE_BANKS) ? 1 : 0);
        size_t altbuffers_size = banks_vect_elements * MEM_VECTOR_FACTOR;
        std::cout << "Allocationg altbank: " << bank << " -- size :" << altbuffers_size << std::endl;
        grid.altbuffers[bank].resize(altbuffers_size);
    }
}

template <typename T>
ap_uint<192> commandGen3Dwrapper(const TestGrid<T>& grid, const TestParameters& params, unsigned int& total_beats, unsigned int& total_pkts, bool& is_small_tile)
{
    unsigned int test_tile_size_x = (params.tile_x + params.read_offset * MEM_VECTOR_FACTOR) <= grid.grid_size_x ? params.tile_x : grid.grid_size_x - params.read_offset * MEM_VECTOR_FACTOR;
    unsigned int test_tile_size_y = params.tile_y <= grid.grid_size_y ? params.tile_y : grid.grid_size_y;
    unsigned int offset_x = params.read_offset;
    unsigned int widen_test_tile_size_x = test_tile_size_x >> LOG2(MEM_VECTOR_FACTOR);

    ap_uint<64> widen_offset = offset_x;
    ap_uint<16> strid_y = grid.grid_size_x >> LOG2(MEM_VECTOR_FACTOR);
    ap_uint<16> strid_z = strid_y * grid.grid_size_y;

    const unsigned int tile_size_y_mul_z_diff = test_tile_size_y * grid.grid_size_z;
    const unsigned int bank_widened_pkts = (test_tile_size_x + LOG2(MEM_VECTOR_FACTOR) - 1) >> LOG2(MEM_VECTOR_FACTOR);
    
    auto command = ops::hls::commandGen3D(widen_offset, 1, (ap_uint<16>)widen_test_tile_size_x, strid_y, (ap_uint<16>)test_tile_size_y, strid_z, (ap_uint<16>)grid.grid_size_z, 0,  0); //Avoids are not needed as read and writing 1 tile

    unsigned int x_pkts = (widen_test_tile_size_x + TILE_BANKS - 1) >> LOG2(TILE_BANKS);
    total_pkts = x_pkts * tile_size_y_mul_z_diff;
    total_beats = widen_test_tile_size_x * tile_size_y_mul_z_diff;
    is_small_tile = widen_test_tile_size_x  <= LOG2(TILE_BANKS/2);


    std::cout <<"[DEBUG][TEST] command gen values" << std::endl;
    std::cout <<"================================" << std::endl;
    std::cout <<" total_pkts_per_lane: " << total_pkts << std::endl;
    std::cout <<" total_beats: " << total_beats << std::endl;
    std::cout <<" is_small_tile: " << is_small_tile << std::endl;
    std::cout <<"================================" << std::endl;

    return command;
}

template <typename T>
bool evaluate(TestGrid<T>& grid_a, TestGrid<T>& grid_b, TestParameters& params)
{
    unsigned int total_beats = 0;
    unsigned int total_pkts = 0;
    bool is_small_tile = false;
    
    // Use grid_a to generate the expected command
    auto command = commandGen3Dwrapper(grid_a, params, total_beats, total_pkts, is_small_tile);

    // Parse parameters from the command
    size_t offset_x_vect = command.range(63,0);
    ap_uint<16> size_x_vect = command.range(95,80);
    ap_uint<16> stride_y = command.range(111,96);
    ap_uint<16> size_y = command.range(127,112);
    ap_uint<16> stride_z = command.range(143,128);
    ap_uint<16> size_z = command.range(159,144);

    // Convert vector bounds to element bounds based on MEM_VECTOR_FACTOR
    size_t start_x = offset_x_vect * MEM_VECTOR_FACTOR;
    size_t dim_x = size_x_vect * MEM_VECTOR_FACTOR;
    size_t dim_y = size_y;
    size_t dim_z = size_z;

    std::cout << "\n==== VALIDATING GRID TILE ====" << std::endl;
    std::cout << "Tile Offset X: " << start_x << std::endl;
    std::cout << "Tile Size (X,Y,Z): (" << dim_x << ", " << dim_y << ", " << dim_z << ")" << std::endl;

    unsigned int mismatches = 0;

    // Evaluate the expected tile against the received tile buffer
    for (size_t z = 0; z < dim_z; z++) {
        for (size_t y = 0; y < dim_y; y++) {
            for (size_t x = 0; x < dim_x; x++) {
                // Calculate absolute coordinates
                size_t abs_x = start_x + x;
                size_t abs_y = y; // Assuming 0-based Y and Z offsets per commandGen3D call
                size_t abs_z = z;
                
                // Calculate flattened 1D buffer index
                size_t idx = abs_x + 
                             abs_y * grid_a.grid_size_x + 
                             abs_z * grid_a.grid_size_x * grid_a.grid_size_y;

                T expected_val = grid_a.buffer[idx];
                T actual_val = grid_b.buffer[idx];

                if (expected_val != actual_val) {
                    if (mismatches < 10) {
                        std::cout << "MISMATCH at tile[" << x << "," << y << "," << z << "] "
                                  << "(grid[" << abs_x << "," << abs_y << "," << abs_z << "]): "
                                  << "expected=" << expected_val << ", got=" << actual_val << std::endl;
                    }
                    mismatches++;
                }
            }
        }
    }

    if (mismatches == 0) {
        std::cout << "✓ VALIDATION PASSED: All output data matches expected tile values\n" << std::endl;
        return true;
    } else {
        std::cout << "✗ VALIDATION FAILED: " << mismatches << " mismatches found\n" << std::endl;
        return false;
    }
}

