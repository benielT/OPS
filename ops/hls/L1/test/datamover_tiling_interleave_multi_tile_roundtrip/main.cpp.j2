template <typename T>
struct TestGrid{
    host_buffer_t<T> buffer;
    std::vector<host_buffer_t<T>> altbuffers = std::vector<host_buffer_t<T>>(TILE_BANKS);
    unsigned short grid_size_x;
    unsigned short grid_size_y;
    unsigned short grid_size_z;
};

template <typename T>
void print_grid(TestGrid<T>& grid, std::string prompt = "grid") {
    std::cout << "*****************************************************************************" << std::endl;
    std::cout << "    Grid : " << prompt << ", Size: (" << grid.grid_size_x << ", " << grid.grid_size_y << ", " << grid.grid_size_z << ")" << std::endl;
    std::cout << "*****************************************************************************" << std::endl << std::endl;

    for (unsigned short z = 0; z < grid.grid_size_z; z++) {
        std::cout << "=============================== [PLANE " << (int)z << "] ===============================" << std::endl;
        for (unsigned short y = 0; y < grid.grid_size_y; y++) {
            std::cout << "|p:" << (int)z << "|r:" << (int)y << "| ";
            for (unsigned short x = 0; x < grid.grid_size_x; x++) {
                size_t idx = z * grid.grid_size_y * grid.grid_size_x + y * grid.grid_size_x + x;
                std::cout << std::setw(10) << grid.buffer[idx] << " ";
            }
            std::cout << std::endl;
        }
        std::cout << "=============================== [END PLANE " << (int)z << "] ===============================" << std::endl;
        std::cout << std::endl;
    }
}

template <typename T>
void print_altbuffers(TestGrid<T>& grid) {
    std::cout << "*****************************************************************************" << std::endl;
    std::cout << "  Grid : " << getName(grid) << "alternative bank buffers print " << std::endl;
    std::cout << "*****************************************************************************" << std::endl << std::endl;

    size_t total_vect_elements = grid.grid_size_x / MEM_VECTOR_FACTOR * grid.grid_size_y * grid.grid_size_z;

    for (int bank = 0; bank < TILE_BANKS; bank++) {

        size_t banks_vect_elements = (total_vect_elements / TILE_BANKS) + (bank < (total_vect_elements % TILE_BANKS) ? 1 : 0);
        size_t altbuffers_size = banks_vect_elements * MEM_VECTOR_FACTOR;
        std::cout << std::endl;
        std::cout << "*****************************************************************************" << std::endl;
        std::cout << "bank: " << bank << " -- size :" << altbuffers_size << std::endl;
        std::cout << "*****************************************************************************" << std::endl << std::endl;

        int prev_x=0, prev_y=0, prev_z=0;

        for (int vect_i = 0; vect_i < banks_vect_elements; vect_i++) {
            int abs_i_begin = (vect_i * TILE_BANKS + bank) * MEM_VECTOR_FACTOR;
            int altbuff_idx_begin = vect_i * MEM_VECTOR_FACTOR;
            for (int j = 0; j < MEM_VECTOR_FACTOR; j++)
            {
                int altbuff_idx = altbuff_idx_begin + j;
                int abs_index_in_orig = abs_i_begin + j;
                int x = abs_index_in_orig % grid.grid_size_x;
                int y = (abs_index_in_orig / grid.grid_size_x) % grid.grid_size_y;
                int z = abs_index_in_orig / (grid.grid_size_x * grid.grid_size_y);

                if (prev_y != y)
                    std::cout << std::endl;
                if (prev_z != z)
                    std::cout << "=============================== [PLANE " << (int)z << "] ===============================" << std::endl;

                std::cout << std::setw(14) << "[" << x << "," << y << "]:" << grid.altbuffers[bank][altbuff_idx] << " ";
                prev_x = x;
                prev_y = y;
                prev_z = z;
            }
        }
        std::cout << std::endl;
    }
}

template <typename T>
void split_grid(TestGrid<T>& grid) {
    for (unsigned int k = 0; k < grid.grid_size_z; k++) {
        for (unsigned int j = 0; j < grid.grid_size_y; j++) {
            for (unsigned int i = 0; i < grid.grid_size_x; i+=MEM_VECTOR_FACTOR) {
                unsigned long abs_index = i + j * grid.grid_size_x 
                                            + k * grid.grid_size_x * grid.grid_size_y;
                
                unsigned long vectored_index = abs_index / MEM_VECTOR_FACTOR;
                unsigned int bank = vectored_index % TILE_BANKS;
                unsigned long bank_index = vectored_index / TILE_BANKS;
                bank_index *= MEM_VECTOR_FACTOR;
                size_t src_offset = k * grid.grid_size_x * grid.grid_size_y
                            + j * grid.grid_size_x + i;
                size_t dst_offset = bank_index;
                std::memcpy(&(grid.altbuffers[bank][dst_offset]),
                        &(grid.buffer[src_offset]),
                        MEM_VECTOR_FACTOR * sizeof(T));
            }
        }
    }
}

template <typename T>
void join_grid(TestGrid<T>& grid) {
    for (unsigned int k = 0; k < grid.grid_size_z; k++) {
        for (unsigned int j = 0; j < grid.grid_size_y; j++) {
            for (unsigned int i = 0; i < grid.grid_size_x; i+=MEM_VECTOR_FACTOR) {
                unsigned long abs_index = i + j * grid.grid_size_x 
                                            + k * grid.grid_size_x * grid.grid_size_y;
                
                unsigned long vectored_index = abs_index / MEM_VECTOR_FACTOR;
                unsigned int bank = vectored_index % TILE_BANKS;
                unsigned long bank_index = vectored_index / TILE_BANKS;
                bank_index *= MEM_VECTOR_FACTOR;
                size_t src_offset = k * grid.grid_size_x * grid.grid_size_y
                            + j * grid.grid_size_x + i;
                size_t dst_offset = bank_index;
                std::memcpy( &(grid.buffer[src_offset]),&(grid.altbuffers[bank][dst_offset]),
                        MEM_VECTOR_FACTOR * sizeof(T));
            }
        }
    }
}

