        std::cout << "*****************************************************************************" << std::endl << std::endl;
        
        TestParameters params;
        
        random_stimulus(params);
        
        std::cout << "===================================================" << std::endl;
        std::cout << "Test Parameters " << std::endl;
        std::cout << "---------------------------------------------------" << std::endl;
        
        std::cout << "      logica_grid_size    : (" << params.logic_size_x <<", " << params.logic_size_y << ", " << params.logic_size_z << ")" << std::endl;
        std::cout << "      grid_size           : (" << params.grid_size_x <<", " << params.grid_size_y << ", " << params.grid_size_z <<  ")" << std::endl;
        std::cout << "      tile_size           : (" << params.tile_x << ", " << params.tile_y << ")" << std::endl;
        std::cout << "      stencil_d           : " << params.stencil_d << std::endl;
        std::cout << "      test_seed           : " << params.test_seed << std::endl;
        std::cout << "      tile_read_offset    : " << params.read_offset << std::endl;
        std::cout << "===================================================" << std::endl;

        TestGrid<stencil_type> grid, grid_receive;
        generate_grid(grid, params);
        generate_grid(grid_receive, params, true); // Initialize zero grid
        std::cout << "split_grid" << std::endl;

        split_grid(grid);
        split_grid(grid_receive);

#ifdef DEBUG_LOG 
        print_grid(grid, "grid");
        print_grid(grid_receive, "grid_receive");
        print_altbuffers(grid);
#endif 

        test_read_write(grid, grid_receive, params);

        join_grid(grid_receive);

#ifdef DEBUG_LOG 
        print_grid(grid_receive, "grid_receive");
        print_altbuffers(grid_receive);
#endif 
        auto score = evaluate(grid, grid_receive, params);
        scoreboard.push_back(score);
    }

    // Final scoreboard
    std::cout << "==========================" << std::endl;
    std::cout << "       TEST SUMMARY" << std::endl;
    std::cout << "==========================" << std::endl;
    for (unsigned int test = 0; test < num_tests; test++) {
        std::cout << "Test " << test + 1 <<": " << (scoreboard[test] ? "PASSED" : "FAILED") << std::endl;
    }
    std::cout << "==========================" << std::endl;

    return 0;
}